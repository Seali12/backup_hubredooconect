    {
      "parameters": {
        "jsCode": "// ======================================================\n// Webhook → preparar disparo restringido Citroen\n// ======================================================\nconst root = $input.first()?.json || {};\nconst body = root.body || root;\n\n// ======================================================\n// DATOS DEL CLIENTE\n// ======================================================\nconst negocio = String(\n  body.pilot_negocio ||\n  body.negocio ||\n  ''\n).trim();\n\nconst firstname =\n  String(body.pilot_firstname || '').trim() ||\n  [body.pilot_firstname, body.pilot_lastname]\n    .filter((v) => v != null && String(v).trim() !== '')\n    .map((v) => String(v).trim())\n    .join(' ') ||\n  'Cliente';\n\n// ======================================================\n// TELÉFONO\n// ======================================================\nlet telefono =\n  body.pilot_cellphone ||\n  body.pilot_phone ||\n  null;\n\nif (!telefono && body.pilot_notes) {\n  const matchWhatsapp = String(body.pilot_notes).match(\n    /n[uú]mero_de_whatsapp:\\s*([+\\d\\s()-]+)/i\n  );\n\n  if (matchWhatsapp) {\n    telefono = matchWhatsapp[1].trim();\n  }\n}\n\n// ======================================================\n// NORMALIZADOR ARGENTINA\n// ======================================================\nfunction normalizarTelefonoArgentina(numero) {\n  if (!numero || typeof numero !== 'string') return null;\n\n  let limpio = numero.replace(/\\D/g, '');\n\n  if (limpio.startsWith('549') && limpio.length === 13) {\n    return limpio;\n  }\n\n  if (limpio.startsWith('54') && limpio.length === 12) {\n    return '549' + limpio.slice(2);\n  }\n\n  if (limpio.startsWith('0')) {\n    limpio = limpio.slice(1);\n  }\n\n  if (limpio.length === 10) {\n    return '549' + limpio;\n  }\n\n  return null;\n}\n\nconst whatsapp = normalizarTelefonoArgentina(\n  telefono == null ? null : String(telefono)\n);\n\n// ======================================================\n// NORMALIZAR NEGOCIO\n// ======================================================\nconst negocioNorm = negocio\n  .normalize('NFD')\n  .replace(/[\\u0300-\\u036f]/g, '')\n  .toUpperCase()\n  .replace(/\\s+/g, ' ')\n  .trim();\n\n// ======================================================\n// DETECTAR NEGOCIO\n// ======================================================\nconst hasCitroen = negocioNorm.includes('CITROEN');\n\nconst has0km =\n  negocioNorm.includes('0KM') ||\n  negocioNorm.includes('0 KM') ||\n  /(?:^|\\s)0\\s*KM(?:\\s|$)/.test(negocioNorm);\n\nconst hasPlan =\n  negocioNorm.includes('AHORRO') ||\n  negocioNorm.includes('PLAN');\n\n// ======================================================\n// DATOS TWILIO\n// ======================================================\nconst ACCOUNT_SID = 'TWILIO_SID_OCULTO';\n\nconst MESSAGING_SERVICE_SID =\n  'MG2f017dd3c25d710216538e8064169bb7';\n\nconst FROM_PHONE = 'whatsapp:+5491125599175';\n\n// ======================================================\n// TEMPLATES\n// ======================================================\nconst MEDIA_OKM =\n  '01_perfil_20260408_171557.jpg';\n\nconst MEDIA_PDA =\n  'WhatsApp-Image-2025-07-14-at-12.32.12-PM_20251110_100927.jpeg';\n\nconst templates = [\n  {\n    ok: () => hasCitroen && hasPlan,\n    tipo: 'PDA',\n    label: 'CITROEN PLAN DE AHORRO',\n    contentSid: 'HX8ae4c2c498c9360772e9f5303a642d70',\n    media: MEDIA_PDA\n  },\n  {\n    ok: () => hasCitroen && has0km,\n    tipo: 'OKM',\n    label: 'CITROEN 0KM',\n    contentSid: 'HX02a1a8e02d56a919fb9e39612b412f16',\n    media: MEDIA_OKM\n  }\n];\n\n// ======================================================\n// BUSCAR TEMPLATE\n// ======================================================\nconst tpl = templates.find((t) => t.ok()) || null;\n\n// ======================================================\n// VARIABLES DEL TEMPLATE\n// ======================================================\nconst contentVariablesObj = tpl\n  ? {\n      '1': firstname,\n      '2': tpl.media,\n      '3': '1231312312312'\n    }\n  : null;\n\nconst contentVariables = contentVariablesObj\n  ? JSON.stringify(contentVariablesObj)\n  : null;\n\n// ======================================================\n// VALIDACIONES\n// ======================================================\nconst telefonoValido = whatsapp !== null;\nconst negocioValido = tpl !== null;\n\nconst valido =\n  telefonoValido &&\n  negocioValido;\n\n// ======================================================\n// SALIDA\n// ======================================================\nreturn [\n  {\n    json: {\n      valido,\n\n      telefonoValido,\n      negocioValido,\n\n      whatsapp,\n      to_phone: whatsapp,\n\n      negocio,\n      negocioNorm,\n\n      tipo: tpl?.tipo || null,\n      templateLabel: tpl?.label || null,\n\n      firstname,\n\n      account_sid: ACCOUNT_SID,\n      messaging_service_sid: MESSAGING_SERVICE_SID,\n      from_phone: FROM_PHONE,\n\n      content_sid: tpl?.contentSid || null,\n      content_variables: contentVariables,\n\n      original: telefono,\n\n      source: 'n8n:autofrance-citroen-restricciones'\n    }\n  }\n];"
      },
