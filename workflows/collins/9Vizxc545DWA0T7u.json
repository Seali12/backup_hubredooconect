    {
      "parameters": {
        "jsCode": "// 1. Obtener los datos de entrada de forma segura\nconst inputData = $input.first().json;\nconst productoInteres = inputData.ProductoInteres || \"\";\nconst modelo = productoInteres.toLowerCase();\n\n// 2. Definición de configuración por modelo\nconst filas = {\n  axor: {\n    app_key: \"855B2202-E756-4057-BB0D-BE4107F987A0\",\n    origen: \"G39JVAVNQBRXAWHS1\",\n    tipo_negocio: 6,\n    descripcion: \"AXOR 3344 - WTS - Redoo\"\n  },\n  atego: {\n    app_key: \"855B2202-E756-4057-BB0D-BE4107F987A0\",\n    origen: \"G39JVP2TLJFYUGDTS\",\n    tipo_negocio: 6,\n    descripcion: \"Atego 3132 - WTS - Redoo\"\n  },\n  arocs: {\n    app_key: \"855B2202-E756-4057-BB0D-BE4107F987A0\",\n    origen: \"G39I8QFNI65GRMUPS\",\n    tipo_negocio: 6,\n    descripcion: \"Arocs 4848 - WTS - Redoo\"\n  },\n  actros: {\n    app_key: \"855B2202-E756-4057-BB0D-BE4107F987A0\",\n    origen: \"G4H7DV0MB15V1W6J5\",\n    tipo_negocio: 6,\n    descripcion: \"ACTROS - wts - Redoo\"\n  },\n  vans: {\n    app_key: \"855B2202-E756-4057-BB0D-BE4107F987A0\",\n    origen: \"FHHBQ85LIGDSJOAV5\",\n    tipo_negocio: 5,\n    descripcion: \"VANS - SPRINTER - WTS - Redoo\"\n  }\n};\n\n// 3. Lógica de detección de keyword\nlet filaSeleccionada = null;\nif (modelo.includes(\"axor\")) {\n  filaSeleccionada = filas.axor;\n} else if (modelo.includes(\"atego\")) {\n  filaSeleccionada = filas.atego;\n} else if (modelo.includes(\"arocs\")) {\n  filaSeleccionada = filas.arocs;\n} else if (modelo.includes(\"actro\")) {\n  filaSeleccionada = filas.actros;\n} else if (modelo.includes(\"vans\") || modelo.includes(\"sprinter\")) {\n  filaSeleccionada = filas.vans;\n}\n\n// 4. Transformación de campos a Booleano\nconst quiereAsesor = String(inputData.Asesor).toLowerCase() === 'si';\nconst quiereTestDrive = String(inputData.TestDrive).toLowerCase() === 'si';\n\n// 5. Manejo de error si no hay match\nif (!filaSeleccionada) {\n  return [{\n    json: {\n      ...inputData,\n      TestDrive: quiereTestDrive,\n      Asesor: quiereAsesor,\n      error: true,\n      mensaje: `No se encontró configuración para el modelo: ${productoInteres}`\n    }\n  }];\n}\n\n// 6. Output final con datos combinados\nreturn [{\n  json: {\n    ...inputData,\n    Asesor: quiereAsesor,\n    TestDrive: quiereTestDrive,\n    app_key: filaSeleccionada.app_key,\n    origen: filaSeleccionada.origen,\n    tipo_negocio: filaSeleccionada.tipo_negocio,\n    descripcion: filaSeleccionada.descripcion\n  }\n}];"
      },
