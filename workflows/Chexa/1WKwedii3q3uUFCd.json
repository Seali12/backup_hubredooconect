        "name": "When Executed by Another Workflow"
      },
      {
        "parameters": {
          "jsCode": "return (() => {\n  const p1=$('CORDOBA_1').first().json.turnosDisponibles\n  const p2=$('CORDOBA_2').first().json.turnosDisponibles\n  const allTurnos = [...p1, ...p2]\n  \n  function pick(arr){\n    const res=[]\n    const days=[...new Set(arr.map(t=>t.dia))]\n    \n    // Primero intenta tomar uno por día\n    while(res.length<6 && days.length){\n      const d=days.splice(Math.floor(Math.random()*days.length),1)[0]\n      const opts=arr.filter(t=>t.dia===d)\n      if(opts.length)res.push(opts[Math.floor(Math.random()*opts.length)])\n    }\n    \n    // Si no llegó a 5, completa con turnos de días ya usados\n    while(res.length<6){\n      const remaining = arr.filter(t => !res.some(r => r.dia === t.dia && r.inicio === t.inicio))\n      if(remaining.length === 0) break\n      res.push(remaining[Math.floor(Math.random()*remaining.length)])\n    }\n    \n    return res.map(t=>({dia:t.dia,inicio:t.inicio,final:t.final,Id_Calendario:t.Id_Calendario}))\n  }\n  \n  return [{json: {turnos: pick(allTurnos)}}]\n})()"
        },
