    {
      "parameters": {
        "jsCode": "// ===============================\n// 1️⃣ INPUT\n// ===============================\n\nconst item = $input.first().json;\nconst localidadElegida = (item.localidad_elegida || \"\").toLowerCase();\n\n// ===============================\n// 2️⃣ TABLA DE CONCESIONARIOS\n// ===============================\n\nconst concesionarios = [\n  { nombre: \"Citydrive\", clave: \"citydrive\" },\n  { nombre: \"Jetour Paris\", clave: \"jetour_paris\" },\n  { nombre: \"Jetour Fortino\", clave: \"jetour_fortino\" },\n  { nombre: \"Jetour Mac Motors\", clave: \"jetour_mac_motors\" },\n  { nombre: \"Jetour Fengtai\", clave: \"jetour_fengtai\" },\n  { nombre: \"Jetour Mega Motors\", clave: \"jetour_mega_motors\" },\n  { nombre: \"Jetour Pesado Castro\", clave: \"jetour_pesado_castro\" },\n  { nombre: \"Jetour Oeste\", clave: \"jetour_oeste\" },\n  { nombre: \"Jetour Panamer\", clave: \"jetour_panamer\" },\n  { nombre: \"Jetour Dalian\", clave: \"jetour_dalian\" },\n  { nombre: \"Jetour Asia Premium\", clave: \"jetour_asia_premium\" },\n  { nombre: \"Jetour Buenos Aires\", clave: \"jetour_buenos_aires\" },\n  { nombre: \"Jetour Ren Motors\", clave: \"jetour_ren_motors\" },\n  { nombre: \"Jetour Horizonte\", clave: \"jetour_horizonte\" },\n  { nombre: \"Jetour Guini\", clave: \"jetour_guini\" },\n  { nombre: \"Jetour Surmotors\", clave: \"jetour_surmotors\" }\n];\n\n// ===============================\n// 3️⃣ BUSCAR COINCIDENCIA\n// ===============================\n\nlet ruteo = null;\n\nfor (const concesionario of concesionarios) {\n  if (localidadElegida.includes(concesionario.nombre.toLowerCase())) {\n    ruteo = concesionario.clave;\n    break;\n  }\n}\n\n// ===============================\n// 4️⃣ OUTPUT\n// ===============================\n\nreturn [\n  {\n    json: {\n      ...item,\n      ruteo\n    }\n  }\n];"
      },
