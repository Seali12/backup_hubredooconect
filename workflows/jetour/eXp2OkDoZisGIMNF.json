        "parameters": {
          "jsCode": "// Datos\nconst grupoCaptura = $('When Executed by Another Workflow').first().json.grupo_captura;\nconst item = $input.first().json;\n\n// Clave original del sheet\nconst claveRuteo = item[\"Clave de Ruteo\"];\n\n// Convertimos a array\nconst rutas = claveRuteo.split('\\n').map(r => r.trim());\n\n// Clonamos todo el objeto del sheet\nlet output = { ...item };\n\n// Validación → solo pisamos si coincide\nif (rutas.includes(grupoCaptura)) {\n  output[\"Clave de Ruteo\"] = grupoCaptura;\n}\n\n// Devolvemos TODO el objeto + opcional debug\nreturn [\n  {\n    json: {\n      ...output,\n      grupo_captura: grupoCaptura,\n      clave_ruteo_original: claveRuteo\n    }\n  }\n];"
        },
