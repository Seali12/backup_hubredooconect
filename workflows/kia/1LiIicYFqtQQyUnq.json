    {
      "parameters": {
        "jsCode": "const telefono = $('Edit Fields21').first().json.tel\n\nfunction normalizarTelefonoArgentina(numero) {\n  // Eliminar cualquier caracter que no sea número\n  let limpio = numero.replace(/\\D/g, '');\n\n  // Si empieza con 9 y sigue un 11 (o cualquier otra característica de celular), quitamos el 9\n  if (limpio.length >= 11 && limpio.startsWith('9')) {\n    limpio = limpio.substring(1);\n  }\n\n  // Si ya tiene el formato correcto\n  if (limpio.startsWith('549') && limpio.length === 13) {\n    return limpio;\n  }\n\n  // Si empieza con '0', le quitamos el 0 y le agregamos '549'\n  if (limpio.startsWith('0')) {\n    limpio = '549' + limpio.slice(1);\n  } else if (limpio.length === 10 && limpio.startsWith('11')) {\n    // Si tiene 10 dígitos y empieza con 11 (sin el 0)\n    limpio = '549' + limpio;\n  } else if (limpio.length === 10) {\n    // Otros casos de interior del país\n    limpio = '549' + limpio;\n  } else {\n    // No matchea nada\n    return null;\n  }\n\n  // Validamos largo final\n  return limpio.length === 13 ? limpio : null;\n}\n\n\nconst whatsapp = normalizarTelefonoArgentina(telefono);\n\nreturn {\n  whatsapp: whatsapp\n}"
      },
