    {
      "parameters": {
        "jsCode": "const nodoOrigen = $('When Executed by Another Workflow').first().json;\n\nconst modeloRaw = nodoOrigen.modelo;\nconst comentariosRaw = nodoOrigen.comentarios;\n\nconst texto = (modeloRaw && modeloRaw.toString().trim())\n  ? modeloRaw.toString()\n  : (comentariosRaw && comentariosRaw.toString().trim())\n    ? comentariosRaw.toString()\n    : '';\n\nconst modeloLower = texto.toLowerCase();\n\nlet model;\nlet code;\n\nif (modeloLower.includes('hilux')) {\n  model = 'Hilux';\n  code = '1';\n} else if (modeloLower.includes('corolla cross')) {\n  model = 'Corolla Cross';\n  code = '245';\n} else if (modeloLower.includes('corolla') && !modeloLower.includes('cross')) {\n  model = 'Corolla';\n  code = '2';\n} else if (modeloLower.includes('yaris')) {\n  model = 'Yaris';\n  code = '227';\n} else if (modeloLower.includes('etios')) {\n  model = 'Etios';\n  code = '225';\n} else if (modeloLower.includes('sw4')) {\n  model = 'SW4';\n  code = '226';\n} else if (modeloLower.includes('hiace')) {\n  model = 'Hiace';\n  code = '224';\n} else if (modeloLower.includes('rav4') || modeloLower.includes('rav 4')) {\n  model = 'RAV4';\n  code = '3';\n} else {\n  model = 'Etios';\n  code = '225'; // default\n}\n\nreturn [{ json: { model, code } }];"
      },
      "type": "n8n-nodes-base.code",
