      {
        "parameters": {
          "jsCode": "const body = $input.item.json.body;\nconst { tel_sufijo, updates } = body;\n\nif (!tel_sufijo || !updates || Object.keys(updates).length === 0) {\n  throw new Error('Faltan parámetros');\n}\n\nconst setClauses = Object.entries(updates)\n  .map(([key, value]) => {\n    if (typeof value === 'number') return `${key} = ${value}`;\n    return `${key} = '${String(value).replace(/'/g, \"''\")}'`;\n  })\n  .join(', ');\n\nreturn {\n  json: {\n    query: `UPDATE meli_leads SET ${setClauses} WHERE RIGHT(REGEXP_REPLACE(buyer_phone, '[^0-9]', ''), 8) = '${tel_sufijo}' AND status IN ('active', 'sent') AND received_at >= DATE_SUB(NOW(), INTERVAL 4 HOUR)`\n  }\n};"
        },
