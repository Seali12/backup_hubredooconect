      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT status, motivo, interes, COUNT(*) AS n\nFROM (\nSELECT *\nFROM mydatabase.nissan_salesforce\nWHERE survey_sent = 0\n  AND interes IN ('Warm', 'Hot', 'Cold')\n  AND (\n    motivo LIKE 'Lead contest%primer mensaje%'\n    OR (motivo LIKE 'MELI%' AND interes IN ('Warm', 'Hot'))\n  )\n  AND updated_at >= CURDATE() - INTERVAL 13 DAY\n  AND updated_at < CURDATE()\n) t\nGROUP BY status, motivo, interes;"
