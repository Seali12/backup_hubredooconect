    {
      "parameters": {
        "jsCode": "// Tomar el item de entrada\nconst item = $input.first().json;\n\n// Normalizar el ProductoInteres a minúsculas para comparación\nconst productoNormalizado = (item.ProductoInteres || '').toLowerCase();\n\n// Mapeo de marcas a businesstypeid y grupoCaptura\nconst marcasConfig = {\n  'renault': { businesstypeid: '4', grupoCaptura: 'renault' },\n  'nissan': { businesstypeid: '5', grupoCaptura: 'nissan' },\n  'jmc': { businesstypeid: '30', grupoCaptura: 'jmc' },\n  'mitsubishi': { businesstypeid: '21', grupoCaptura: 'mitsubishi' },\n  'changan': { businesstypeid: '31', grupoCaptura: 'changan' },\n  'gwm': { businesstypeid: '35', grupoCaptura: 'gwm' },\n  'leapmotor': { businesstypeid: '36', grupoCaptura: 'leapmotor' },\n  'omoda': { businesstypeid: '32', grupoCaptura: 'omoda' },\n  'jaecoo': { businesstypeid: '33', grupoCaptura: 'jaecoo' },\n  'zeekr': { businesstypeid: '38', grupoCaptura: 'zeekr' },\n  'deepal': { businesstypeid: '43', grupoCaptura: 'deepal' },\n  'xpeng': { businesstypeid: '39', grupoCaptura: 'xpeng' }\n};\n\n// Buscar si alguna marca está en el ProductoInteres\nlet marcaEncontrada = null;\nfor (const marca in marcasConfig) {\n  if (productoNormalizado.includes(marca)) {\n    marcaEncontrada = marca;\n    break;\n  }\n}\n\n// Si se encontró una marca, actualizar businesstypeid y grupoCaptura\nif (marcaEncontrada) {\n  item.businesstypeid = marcasConfig[marcaEncontrada].businesstypeid;\n  item.grupoCaptura = marcasConfig[marcaEncontrada].grupoCaptura;\n}\n\n\n// Devolver todo el JSON\nreturn [\n  {\n    json: item\n  }\n];"
      },
