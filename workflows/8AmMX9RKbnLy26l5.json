      "id": "6e0548f8-d7ce-4c62-9ebe-b10c716803f6",
      "name": "Resumen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        0
      ],
      "parameters": {
        "jsCode": "const src = $('Telefonos').all();\nconst rows = [];\n$input.all().forEach((it, i) => {\n  const r = it.json.result || {}; let L = r.entitydata; if (!L) { rows.push({ json: { tel: src[i].json.tel, encontrados: 0, status: r.status || JSON.stringify(it.json).slice(0,200) } }); return; }\n  if (!Array.isArray(L)) L = L.welcomes || L.list || L.items || [L];\n  if (!L.length) rows.push({ json: { tel: src[i].json.tel, encontrados: 0 } });\n  L.forEach(e => rows.push({ json: { tel: src[i].json.tel, cel: (e.prospect||{}).cellphone, guid: e.id, num: e.number || e.welcome_number || e.code, nombre: ((e.prospect||{}).firstname||'') + ' ' + ((e.prospect||{}).lastname||''), creado: (e.created||{}).dt, creado_por: ((e.created||{}).user||{}).fullname, origen: (e.origin||{}).code, suborigen: (e.suborigin||{}).code, negocio: (e.business_type||{}).code, fuente: (e.source_type||{}).code, estado: (e.status||{}).name, interes: (e.interest_level||{}).name, asignado: ((e.asigned||{}).user||{}).fullname, desist: ((e.desist||{}).status||{}).name, keys: Object.keys(e).slice(0,40).join(',') } }));\n});\nreturn rows;"
      }
    }
  ],
