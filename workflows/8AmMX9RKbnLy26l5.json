        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ \"data\": { \"limit\": 20, \"page\": 1, \"filters\": [ { \"field\": \"welcome_cellphone\", \"operation\": \"LIKE\", \"value\": $json.tel.slice(-8) } ], \"wildCard\": \"*\", \"sorts\": [ { \"field\": \"created\", \"order\": \"DESC\" } ] }, \"header\": { \"FlowName\": \"List_Leads\", \"SequenceId\": 1, \"TimeStamp\": 1248377, \"TrackingId\": \"FD1C4A1A-CAFB-467E-825B-7FFB86CC21E3\", \"access_token\": $(\"Pilot authorization\").first().json.result.entitydata.session.identityToken } }) }}",
