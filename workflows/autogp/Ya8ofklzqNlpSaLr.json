      "id": "8ded7ce9-1c6f-4b17-ae3c-f2675406cf5c",
      "name": "Merge"
    },
    {
      "parameters": {
        "jsCode": "const allEntities = [];\nfor (const item of $input.all()) {\n  const entitydata = item.json?.result?.entitydata;\n  if (Array.isArray(entitydata)) {\n    allEntities.push(...entitydata);\n  }\n}\n\n// Filtrar los no disponibles (availability_status.code === \"3\")\nconst available = allEntities.filter(v => v.availability_status?.code !== \"3\");\n\n// Mapear solo los campos necesarios\nconst mapped = available.map(v => ({\n  id: v.id,\n  integration_reference_code: v.integration_reference_code,\n  brand: v.brand,\n  model: v.model,\n  version: v.version,\n  year: v.year,\n  color: v.color,\n}));\n\n// Ordenar por brand (alfabéticamente)\nmapped.sort((a, b) => (a.brand || \"\").localeCompare(b.brand || \"\"));\n\n// Marcas únicas ordenadas\nconst brands = [...new Set(mapped.map(v => v.brand).filter(Boolean))].sort();\n\nreturn [{ json: { total: mapped.length, brands, entitydata: mapped } }];"
      },
