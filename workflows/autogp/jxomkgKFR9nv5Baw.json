        "jsonBody": "={\n\t\"data\": {\n\t\t\"filters\": [\n\t\t],\n\t\t\"sort\": [\n\t\t\t{\n\t\t\t\t\"field\": \"updated\",\n\t\t\t\t\"order\": \"DESC\"\n\t\t\t}\n\t\t],\n\t\t\"limit\": 100,\n\t\t\"page\": 1\n\t},\n\t\"header\": {\n\t\t\"FlowName\": \"stock_list\",\n        \"SequenceId\": 1,\n        \"TimeStamp\": 1248377,\n        \"TrackingId\": \"55A6BCD4-0857-4A86-85FB-09A228B641B4\",\n    \t\"access_token\":\"{{ $json.result.entitydata.session.identityToken }}\"\n    }\n\n}",
        "options": {}
      },
      "id": "e0867b5c-f74a-41e6-a79b-eaf0b1e85c08",
      "name": "getPrecios",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        896,
        -16
      ]
    },
    {
      "parameters": {
        "jsCode": "// -------------------------------------------------\n// 1. OBTENER LOS DATOS CORRECTAMENTE\n// -------------------------------------------------\nconst allEntities = [];\nfor (const item of $input.all()) {\n  const entitydata = item.json?.result?.entitydata;\n  if (Array.isArray(entitydata)) {\n    allEntities.push(...entitydata);\n  }\n}\nconsole.log('Vehículos recibidos:', allEntities.length);\n\n// -------------------------------------------------\n// 2. FILTRAR SOLO PUBLICADOS EN WEB Y DISPONIBLES\n// -------------------------------------------------\nconst publicados = allEntities.filter(v => \n  v.published_in_web === \"1\" && \n  v.availability_status?.code === \"1\"\n);\nconsole.log('Publicados en web y disponibles:', publicados.length);\n\n// -------------------------------------------------\n// 3. NORMALIZAR DATOS Y OBTENER PRECIO\n// -------------------------------------------------\nconst normalizados = publicados.map(v => {\n  const prices = Array.isArray(v.prices) ? v.prices : [];\n  const salePrice = prices.find(p => p.type === 'SALE_COST');\n  const precio = salePrice && salePrice.value ? parseFloat(salePrice.value) : 0;\n  \n  const marca = (v.brand || 'SIN_MARCA').trim();\n  const modelo = (v.model || 'SIN_MODELO').trim();\n  const version = (v.version || '').trim();\n  const year = v.year || '';\n  \n  return {\n    key: `${marca}|${modelo}|${version}|${year}`,\n    marca,\n    modelo_corto: modelo,\n    modelo_completo: `${modelo} ${version} ${year}`.replace(/\\s+/g, ' ').trim(),\n    precio\n  };\n});\n\n// -------------------------------------------------\n// 4. ELIMINAR DUPLICADOS (MAYOR PRECIO)\n// -------------------------------------------------\nconst porModeloUnico = normalizados.reduce((acc, item) => {\n  if (!acc[item.key] || item.precio > acc[item.key].precio) {\n    acc[item.key] = item;\n  }\n  return acc;\n}, {});\n\nconst itemsFiltrados = Object.values(porModeloUnico);\nconsole.log('Modelos únicos:', itemsFiltrados.length);\n\n// -------------------------------------------------\n// 5. AGRUPAR POR MARCA\n// -------------------------------------------------\nconst porMarca = itemsFiltrados.reduce((acc, item) => {\n  if (!acc[item.marca]) {\n    acc[item.marca] = [];\n  }\n  acc[item.marca].push({\n    precio: item.precio,\n    modelo_corto: item.modelo_corto,\n    modelo_completo: item.modelo_completo,\n    marca: item.marca\n  });\n  return acc;\n}, {});\n\nconsole.log('Marcas encontradas:', Object.keys(porMarca));\n\n// -------------------------------------------------\n// 6. DEVOLVER RESULTADO\n// -------------------------------------------------\nreturn [\n  {\n    json: {\n      total_modelos: itemsFiltrados.length,\n      por_marca: porMarca\n    }\n  }\n];"
      },
