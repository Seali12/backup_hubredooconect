        "jsonBody": "={\n\t\"data\": {\n\n\t\t\"filters\": [\n\t\t],\n\t\t\"sort\": [\n\t\t\t{\n\t\t\t\t\"field\": \"updated\",\n\t\t\t\t\"order\": \"DESC\"\n\t\t\t}\n\t\t],\n\t\t\"limit\": 100,\n\t\t\"page\": 1\n\t},\n\t\"header\": {\n\t\t\"FlowName\": \"stock_list\",\n        \"SequenceId\": 1,\n        \"TimeStamp\": 1248377,\n        \"TrackingId\": \"55A6BCD4-0857-4A86-85FB-09A228B641B4\",\n    \t\"access_token\":\"{{ $json.result.entitydata.session.identityToken }}\"\n    }\n\n}",
        "options": {}
      },
      "id": "8e6dc585-c5cb-4149-98b7-6a22f2c65730",
      "name": "getPrecios",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        736,
        112
      ]
    },
    {
      "parameters": {
        "jsCode": "// -------------------------------------------------\n// 1. DATOS DE ENTRADA - Combinar todos los items\n// -------------------------------------------------\nconst allEntities = [];\nfor (const item of $input.all()) {\n  const entitydata = item.json?.result?.entitydata;\n  if (Array.isArray(entitydata)) {\n    allEntities.push(...entitydata);\n  }\n}\n\n// -------------------------------------------------\n// 2. SOLO PUBLICADOS EN WEB, NO VENDIDOS Y NO \"No disponible\"\n// -------------------------------------------------\nconst publicados = allEntities.filter(v => {\n  const isPublished = v.published_in_web === \"1\";\n\n  const isNotSold =\n    v.availability_status?.code !== \"3\" &&\n    v.availability_status?.code !== 3;\n\n  const isAvailableByName =\n    (v.availability_status?.name || \"\").toLowerCase() !== \"no disponible\";\n\n  return isPublished && isNotSold && isAvailableByName;\n});\n\n// -------------------------------------------------\n// 3. FORMATEAR VEHÍCULOS\n// -------------------------------------------------\nconst formateados = publicados.map(v => {\n  const prices = Array.isArray(v.prices) ? v.prices : [];\n  const salePrice = prices.find(p => p.type === 'SALE_COST');\n\n  return {\n    id: v.id || null,\n    marca: v.brand || '',\n    modelo: v.model || '',\n    version: v.version || '',\n    anio: v.year || null,\n    tipo: v.type?.code || '',\n    combustible: v.fuel || '',\n    transmision: v.transmission || '',\n    kilometros: v.odometer || 0,\n    color: v.color || '',\n    estado: v.availability_status?.name || '',\n    precio: salePrice ? Number(salePrice.value) : null,\n    publicado_web: true\n  };\n});\n\n// -------------------------------------------------\n// 4. AGRUPAR POR MARCA\n// -------------------------------------------------\nconst porMarca = formateados.reduce((acc, v) => {\n  if (!acc[v.marca]) {\n    acc[v.marca] = [];\n  }\n  acc[v.marca].push(v);\n  return acc;\n}, {});\n\n// -------------------------------------------------\n// 5. DEVOLVER RESULTADO\n// -------------------------------------------------\nreturn [\n  {\n    json: {\n      total_modelos: formateados.length,\n      marcas: Object.keys(porMarca),\n      modelos_por_marca: porMarca\n    }\n  }\n];"
      },
