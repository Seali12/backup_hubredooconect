    {
      "parameters": {
        "jsCode": "// Entrada: debes conectar Google Sheets56 en input[0] y Google Sheets57 en input[1]\n\nconst historial = $(\"Google Sheets\").all().map(item => item.json);\nconst vendedores = $(\"Google Sheets 1\").all().map(item => item.json);\n\n// 1. Si historial está vacío, devolvemos el primer vendedor (Orden más bajo)\nif (historial.length === 0) {\n  const primero = vendedores.reduce((min, v) => v.orden < min.orden ? v : min, vendedores[0]);\n  return [{ json: primero }];\n}\n\n// 2. Tomar el último registro de historial (mayor row_number)\nconst ultimoHistorial = historial.reduce((max, item) => \n  item.row_number > max.row_number ? item : max, historial[0]);\n\nconst vendedorActual = ultimoHistorial.orden;\n\n// 3. Calcular el siguiente vendedor\nconst maxOrden = Math.max(...vendedores.map(v => v.orden));\nlet siguiente = vendedorActual + 1;\n\n// Si supera el máximo, reinicia a 0\nif (siguiente > maxOrden) siguiente = 0;\n\n// 4. Buscar el vendedor en base al Orden\nconst vendedorAsignado = vendedores.find(v => v.orden === siguiente);\n\n// 5. Si solo hay un vendedor, devolver ese\nlet salida;\nif (maxOrden === 0) {\n  salida = vendedores[0];\n} else {\n  salida = vendedorAsignado || vendedores[0]; // fallback por seguridad\n}\n\n// Retornar\nreturn [{json: salida}];"
      },
