      {
        "parameters": {
          "jsCode": "function combinarTurnosPilar() {\n  const pilar1Data = $('PILAR_1').first().json;\n  const pilar2Data = $('PILAR_2').first().json;\n  \n  const turnosPilar1 = pilar1Data.turnosDisponibles || [];\n  const turnosPilar2 = pilar2Data.turnosDisponibles || [];\n  \n  const turnosSeleccionados = [];\n  const turnosVistos = new Set();\n  \n  function crearClaveTurno(turno) {\n    return `${turno.dia}_${turno.inicio}_${turno.final}`;\n  }\n  \n  function agregarTurnos(turnos, limite) {\n    let agregados = 0;\n    for (const turno of turnos) {\n      if (agregados >= limite) break;\n      \n      const clave = crearClaveTurno(turno);\n      if (!turnosVistos.has(clave)) {\n        turnosSeleccionados.push({\n          dia: turno.dia,\n          inicio: turno.inicio,\n          final: turno.final,\n          Id_Calendario: turno.Id_Calendario\n        });\n        turnosVistos.add(clave);\n        agregados++;\n      }\n    }\n  }\n  \n  agregarTurnos(turnosPilar1, 3);\n  agregarTurnos(turnosPilar2, 3);\n  \n  if (turnosSeleccionados.length < 6) {\n    agregarTurnos([...turnosPilar1, ...turnosPilar2], 6 - turnosSeleccionados.length);\n  }\n  \n  turnosSeleccionados.sort((a, b) => {\n    if (a.dia !== b.dia) {\n      return new Date(a.dia) - new Date(b.dia);\n    }\n    return a.inicio.localeCompare(b.inicio);\n  });\n  \n  return turnosSeleccionados.slice(0, 6);\n}\n\nconst turnosCombinados = combinarTurnosPilar();\n\nreturn [{\n  json: {\n    turnosDisponibles: turnosCombinados,\n    cantidadTurnos: turnosCombinados.length\n  }\n}];"
        },
