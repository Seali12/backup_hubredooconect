      {
        "parameters": {
          "method": "POST",
          "url": "=https://api.pilotsolution.net/v1/stock/list.php",
          "sendBody": true,
          "specifyBody": "json",
          "jsonBody": "={\n    \"data\": {\n        \"filters\": [\n            {\n                \"field\": \"availability_status_code\",\n                \"operation\": \"=\",\n                \"value\": \"1\"\n            },\n            {\n                \"field\": \"type_code\",\n                \"operation\": \"=\",\n                \"value\": \"VN\"\n            }\n        ],\n        \"sort\": [\n            {\n                \"field\": \"updated\",\n                \"order\": \"DESC\"\n            }\n        ],\n        \"show_media\": true,\n        \"limit\": 100,\n        \"page\": 1\n    },\n    \"header\": {\n        \"FlowName\": \"stock_list\",\n        \"SequenceId\": 2,\n        \"TimeStamp\": 1248377,\n        \"TrackingId\": \"55A6BCD4-0857-4A86-85FB-09A228B641B4\",\n    \t\"access_token\":\"{{ $json.result.entitydata.session.identityToken }}\"\n  }\n}",
          "options": {}
