        "id": "d268518a-4044-4329-a3eb-48d3169c5aca",
        "name": "getModelos",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [
          704,
          -400
        ]
      },
      {
        "parameters": {
          "jsCode": "// Obtener los datos correctamente\nconst entitydata = $input.first().json.result.entitydata;\n\nconsole.log('Total items recibidos:', entitydata.length);\n\n// Filtrar solo items con \"PVP\" en full_name O code Y visible = \"1\"\nconst itemsConPVP = entitydata.filter(item => {\n  const tienePVPenFullName = item.full_name && item.full_name.toUpperCase().includes('PVP');\n  const tienePVPenCode = item.code && item.code.toUpperCase().includes('PVP');\n  const esVisible = item.visible === \"1\";\n  \n  return (tienePVPenFullName || tienePVPenCode) && esVisible;\n});\n\nconsole.log('Items con PVP y visibles:', itemsConPVP.length);\n\n// Agrupar por integration_code\nconst grouped = itemsConPVP.reduce((acc, item) => {\n  const key = item.integration_code || item.code;\n  \n  if (!acc[key]) {\n    acc[key] = [];\n  }\n  acc[key].push(item);\n  \n  return acc;\n}, {});\n\n// Seleccionar el de mayor precio cuando hay duplicados\nconst itemsFiltrados = Object.values(grouped).map(grupo => {\n  if (grupo.length === 1) {\n    return grupo[0];\n  }\n  \n  return grupo.reduce((max, current) => {\n    const maxPrice = parseFloat(max.price) || 0;\n    const currentPrice = parseFloat(current.price) || 0;\n    return currentPrice > maxPrice ? current : max;\n  });\n});\n\n// Agrupar por marca (business_type.name)\nconst porMarca = itemsFiltrados.reduce((acc, item) => {\n  const marca = item.business_type?.name || 'SIN_MARCA';\n  \n  if (!acc[marca]) {\n    acc[marca] = [];\n  }\n  \n  acc[marca].push({\n    precio: item.price,\n    modelo_corto: item.model?.name || item.name,\n    modelo_completo: item.full_name,\n    marca: marca\n  });\n  \n  return acc;\n}, {});\n\nconsole.log('Marcas encontradas:', Object.keys(porMarca));\n\n// Devolver resultado agrupado\nreturn [{\n  json: {\n    total_modelos: itemsFiltrados.length,\n    por_marca: porMarca\n  }\n}];"
        },
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          864,
          -128
        ],
        "id": "abfc5fe4-cab1-408c-aafe-8233a2fe86f5",
