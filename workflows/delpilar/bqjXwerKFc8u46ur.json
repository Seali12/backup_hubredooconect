      {
        "parameters": {
          "jsCode": "// Nodo Code de n8n\n// Filtra turnos con fecha/hora posterior a \"ahora\" en horario Argentina (UTC-3)\n\nconst items = $input.all();\n\n// Obtener fecha/hora actual en Argentina (UTC-3)\nconst now = new Date();\nconst argentinaOffset = -3 * 60; // minutos\nconst utcMs = now.getTime() + (now.getTimezoneOffset() * 60000);\nconst argNow = new Date(utcMs + (argentinaOffset * 60000));\n\nconst result = [];\n\nfor (const item of items) {\n  const { Fecha, Hora } = item.json;\n  \n  if (!Fecha || !Hora) continue;\n\n  // Normalizar fecha (acepta \"YYYY-MM-DD\" y \"DD/MM/YYYY\")\n  let fechaNorm;\n  if (typeof Fecha === 'string' && Fecha.includes('/')) {\n    const [d, m, y] = Fecha.split('/');\n    fechaNorm = `${y}-${m.padStart(2,'0')}-${d.padStart(2,'0')}`;\n  } else {\n    fechaNorm = String(Fecha).substring(0, 10);\n  }\n\n  // Normalizar hora (acepta \"8:00\", \"8:30:00\", \"8:45\")\n  const horaNorm = String(Hora).substring(0, 5).padStart(5, '0');\n\n  // Construir Date en Argentina\n  const [year, month, day] = fechaNorm.split('-').map(Number);\n  const [hours, minutes] = horaNorm.split(':').map(Number);\n\n  if (!year || isNaN(hours)) continue;\n\n  // Fecha en Argentina: la construimos como si fuera UTC y luego ajustamos\n  const turnoArg = new Date(Date.UTC(year, month - 1, day, hours, minutes) - (argentinaOffset * 60000));\n\n  if (turnoArg > argNow) {\n    result.push(item);\n  }\n}\n\nreturn result;"
        },
