    {
      "parameters": {
        "jsCode": "// Obtenemos los datos del item actual\nconst input = $('Webhook').first().json.body;\n\n// Datos generales\nconst message = input.message;\nconst image = input.image;\nconst link = input.link;\nconst ref = input.ref;\nconst schedules = input.schedule || [];\n\n// 👉 Generamos un id único basado en timestamp\nconst id_publicacion = Date.now().toString(); \n\n// Construimos el array final\nconst result = schedules.map(s => ({\n  id_publicacion,\n  message,\n  image,\n  link,\n  ref,\n  frequency: s.frequency,\n  time: s.time,\n  dayOfWeek: s.dayOfWeek,\n  startDate: s.startDate,\n  endDate: s.endDate\n}));\n\n// Devolvemos como array de items para el MySQL Node\nreturn result.map(r => ({ json: r }));\n"
      },
