    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT \n    id_publicacion,\n    message,\n    image,\n    link,\n    ref,\n    created_dt,\n    JSON_ARRAYAGG(\n        JSON_OBJECT(\n            'frequency', frequency,\n            'time', time,\n            'dayOfWeek', dayOfWeek,\n            'startDate', startDate,\n            'endDate', endDate\n        )\n    ) AS schedules\nFROM programaciones\nGROUP BY id_publicacion, message, image, link\nORDER BY created_dt DESC;\n",
