    {
      "parameters": {
        "jsCode": "const imageData = $json[\"body\"][\"image\"];  \n\n// Separa mimetype y data\nconst matches = imageData.match(/^data:(.+);base64,(.*)$/);\nif (!matches) throw new Error(\"No se pudo parsear la imagen Base64\");\n\nconst mimeType = matches[1];\nconst base64Data = matches[2];\n\n// Convierte Base64 a Buffer\nconst binaryData = Buffer.from(base64Data, 'base64');\n\nreturn [\n  {\n    json: {\n      message: $json.body.message || \"\",\n      link: $json.body.link || \"\"\n    },\n    binary: {\n      file: {\n        data: binaryData,\n        mimeType,\n        fileName: \"upload.jpg\"\n      }\n    }\n  }\n];\n"
      },
