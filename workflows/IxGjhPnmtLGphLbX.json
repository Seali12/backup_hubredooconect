      {
        "parameters": {
          "jsCode": "// ======================================================\n// OBTENER TELÉFONO DESDE EL WEBHOOK\n// ======================================================\nconst telefono = \n  $input.first()?.json?.body?.cliente_cel ||\n  $input.first()?.json?.body?.Telefono ||\n  null;\n\n// ======================================================\n// NORMALIZADOR ARGENTINA (WHATSAPP / TWILIO SAFE)\n// ======================================================\nfunction normalizarTelefonoArgentina(numero) {\n  if (!numero || typeof numero !== 'string') return null;\n\n  // Eliminar todo lo que no sea número\n  let limpio = numero.replace(/\\D/g, '');\n\n  // ==================================================\n  // CASO 1: Ya viene en formato internacional válido\n  // Ej: 541169749551 | 543815765949\n  // ==================================================\n  if (limpio.startsWith('54') && limpio.length >= 12) {\n    return limpio;\n  }\n\n  // ==================================================\n  // CASO 2: Empieza con 0 (formato nacional)\n  // Ej: 011XXXXXXX | 0381XXXXXXX\n  // ==================================================\n  if (limpio.startsWith('0')) {\n    limpio = limpio.slice(1);\n  }\n\n  // ==================================================\n  // CASO 3: Área + número (10 o más dígitos)\n  // Ej: 11XXXXXXX | 381XXXXXXX\n  // ==================================================\n  if (limpio.length >= 10) {\n    return '549' + limpio;\n  }\n\n  // ==================================================\n  // No válido\n  // ==================================================\n  return null;\n}\n\n// ======================================================\n// NORMALIZAR\n// ======================================================\nconst whatsapp = normalizarTelefonoArgentina(telefono);\n\n// ======================================================\n// SALIDA\n// ======================================================\nreturn [\n  {\n    json: {\n      whatsapp: whatsapp,\n      valido: whatsapp !== null,\n      original: telefono\n    }\n  }\n];\n"
        },
