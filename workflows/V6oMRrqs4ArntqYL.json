      "parameters": {
        "jsCode": "const C = { 'Frío': '1', 'Tibio': '3', 'Caliente': '07B7AC5A' };\nconst L = [\n [7843,'11EC09BC-3977-4D18-B190-3216B10E18D2','Tibio','05/11','Explorer Colombia',''],\n [7904,'06918C80-220A-481B-9F66-877D36A949A7','Frío','06/11','Territory Colombia',''],\n [8524,'3021D7C4-15E1-43BE-A146-29D0F4E0912B','Frío','08/11','Ranger Colombia','No respondio el recontacto'],\n [10719,'4B294724-021B-4A00-9077-64D10132AF71','Caliente','17/11','Ranger Colombia',''],\n [10966,'1A5D5C1B-075E-41FB-9551-E3E9FC4A1C0A','Tibio','18/11','TERRITORY',''],\n [10970,'E2155359-BE01-481E-B5B7-97557C169F50','Frío','18/11','Bronco Sport','No respondio el recontacto'],\n];\nreturn L.map(([id,pid,g,f,prod,extra]) => ({ json: { id, pid, grado: g, code: C[g], frio: g === 'Frío',\n  notes: 'INTERES: ' + g + (extra ? ' - ' + extra : '') + ' | Pilot Comentario: Notas:Producto de Interes: ' + prod + ' | //Campaña:Website Colombia | Calificado por el bot el ' + f + ' (sincronizado el 20/11)' } }));"
      }
    },
