        "html": "<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Acceso Denegado</title>\n  <style>\n    * {\n      margin: 0;\n      padding: 0;\n      box-sizing: border-box;\n    }\n    body {\n      background-color: #f5f5f5;\n      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;\n      min-height: 100vh;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      padding: 20px;\n    }\n    .error-container {\n      background: white;\n      border-radius: 16px;\n      box-shadow: 0 20px 60px rgba(0,0,0,0.15);\n      padding: 60px 40px;\n      max-width: 500px;\n      text-align: center;\n    }\n    .error-icon {\n      font-size: 80px;\n      margin-bottom: 24px;\n      opacity: 0.8;\n    }\n    .error-title {\n      color: #1f2937;\n      font-size: 32px;\n      font-weight: 700;\n      margin-bottom: 16px;\n    }\n    .error-message {\n      color: #6b7280;\n      font-size: 18px;\n      line-height: 1.6;\n      margin-bottom: 32px;\n    }\n    .error-code {\n      background: linear-gradient(135deg, #2c3e50 0%, #34495e 100%);\n      color: white;\n      padding: 12px 24px;\n      border-radius: 8px;\n      font-size: 14px;\n      font-weight: 600;\n      display: inline-block;\n      letter-spacing: 1px;\n    }\n  </style>\n</head>\n<body>\n  <div class=\"error-container\">\n    <div class=\"error-icon\">🚫</div>\n    <h1 class=\"error-title\">Acceso Denegado</h1>\n    <p class=\"error-message\">No tenés permiso para acceder a esta página</p>\n    <div class=\"error-code\">ERROR 403 - FORBIDDEN</div>\n  </div>\n</body>\n</html>"
