        "jsCode": "// Tomar el item de entrada\nconst item = $input.first().json;\n\n// Helper: pasa a minúsculas y saca acentos (\"Junín\" → \"junin\")\nconst norm = (v) => (v || '')\n  .toString()\n  .toLowerCase()\n  .normalize('NFD')\n  .replace(/[̀-ͯ]/g, '')\n  .trim();\n\n// Normalizar campos\nconst productoNormalizado = norm(item.ProductoInteres);\nconst sucursalNormalizada = norm(item.sucursal);\nconst tipoVentaNormalizado = norm(item.TipoVenta);\nconst formaPagoNormalizada = norm(item.formapago);\n\n// Mapeo de marcas\nconst marcasConfig = {\n  'renault': { businesstypeid: '4', grupoCaptura: 'renault' },\n  'nissan': { businesstypeid: '5', grupoCaptura: 'nissan' },\n  'jmc': { businesstypeid: '30', grupoCaptura: 'jmc' },\n  'mitsubishi': { businesstypeid: '21', grupoCaptura: 'mitsubishi' },\n  'changan': { businesstypeid: '31', grupoCaptura: 'changan' },\n  'gwm': { businesstypeid: '35', grupoCaptura: 'gwm' },\n  'leapmotor': { businesstypeid: '36', grupoCaptura: 'leapmotor' },\n  'omoda': { businesstypeid: '32', grupoCaptura: 'omoda' },\n  'jaecoo': { businesstypeid: '33', grupoCaptura: 'jaecoo' },\n  'zeekr': { businesstypeid: '38', grupoCaptura: 'zeekr' },\n  'deepal': { businesstypeid: '43', grupoCaptura: 'deepal' },\n  'xpeng': { businesstypeid: '39', grupoCaptura: 'xpeng' }\n};\n\n// Buscar marca\nlet marcaEncontrada = null;\nfor (const marca in marcasConfig) {\n  if (productoNormalizado.includes(marca)) {\n    marcaEncontrada = marca;\n    break;\n  }\n}\n\n// Aplicar marca\nif (marcaEncontrada) {\n  item.businesstypeid = marcasConfig[marcaEncontrada].businesstypeid;\n  item.grupoCaptura = marcasConfig[marcaEncontrada].grupoCaptura;\n}\n\n// ========================\n// LÓGICA origen_pilot\n// ========================\nlet origenPilot = null;\n\n// ITUZAINGO / LELOIR\nif (sucursalNormalizada.includes('ituzaingo') || sucursalNormalizada.includes('leloir')) {\n  if (formaPagoNormalizada === '0km') {\n    origenPilot = 'G48PA83T8KR6HBTOG';\n  } else if (formaPagoNormalizada === 'pda') {\n    origenPilot = 'G48PBDOVWLDV232A9';\n  }\n}\n// RAMOS MEJIA\nelse if (sucursalNormalizada.includes('ramos mejia') || sucursalNormalizada.includes('ramos')) {\n  if (tipoVentaNormalizado.includes('convencional')) {\n    origenPilot = 'G48P83VI3U7GNBTA9';\n  } else {\n    origenPilot = 'G48PAV9XEBNU86VY9';\n  }\n}\n// JUNIN\nelse if (sucursalNormalizada.includes('junin')) {\n  origenPilot = 'G7IM0NZOMXQHHRG9W';\n}\n// PERGAMINO\nelse if (sucursalNormalizada.includes('pergamino')) {\n  origenPilot = 'G7IMAG4O5LNJFGG11';\n}\n\n// Asignar si se encontró valor\nif (origenPilot) {\n  item.origen_pilot = origenPilot;\n}\n\n// Devolver resultado\nreturn [\n  {\n    json: item\n  }\n];"
      },
