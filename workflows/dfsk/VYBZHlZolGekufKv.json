    {
      "parameters": {
        "jsCode": "const item = $('HTTP Request1').first().json;\n\nconst data = item.data || {};\n\nconst normalizePhone = phone => {\n    if (!phone) return null;\n\n    return String(phone)\n        .replace(/\\D/g, '');\n};\n\nconst advisorEmail =\n    data.welcome_assigned_user_email ||\n    data.welcome_assigned_user_name ||\n    \"\";\n\nconst normalizedEmail = advisorEmail.trim().toLowerCase();\n\nconst groupResponse = $('obtenerAsesores').first().json;\nconst rulesResponse = $('obtenerReglas').first().json;\n\nconst users = groupResponse.data?.users || [];\n\nconst assignmentRule = (rulesResponse.data || []).find(\n    rule => Number(rule.id) === 121\n);\n\nconst allowedUserIds = assignmentRule?.configuration?.user_ids || [];\n\nconst advisor = users.find(user => {\n    const userEmail = (user.email || \"\").trim().toLowerCase();\n\n    return (\n        userEmail === normalizedEmail &&\n        allowedUserIds.includes(user.id)\n    );\n});\n\nitem.numero_vendedor = normalizePhone(advisor?.phone);\n\nitem.asesor_nombre =\n    data.welcome_assigned_user_fullname ||\n    (advisor\n        ? `${advisor.first_name || \"\"} ${advisor.last_name || \"\"}`.trim()\n        : null);\n\nitem.asesor_email = advisor?.email || advisorEmail;\nitem.asesor_id = advisor?.id || null;\n\nitem.sucursal = data.welcome_asigned_branch || null;\nitem.lead_id = data.welcome_guid || null;\n\nconsole.log(\"Asignación de vendedor:\", {\n    asesor: item.asesor_nombre,\n    asesorId: item.asesor_id,\n    emailOriginal: advisorEmail,\n    emailNormalizado: normalizedEmail,\n    telefonoEncontrado: item.numero_vendedor,\n    reglaAsignacion: assignmentRule?.id || null,\n    usuariosPermitidos: allowedUserIds,\n    sucursal: item.sucursal,\n    leadId: item.lead_id\n});\n\nreturn [\n    {\n        json: item\n    }\n];"
      },
