      ],
      "parameters": {
        "jsCode": "const wf = $input.first().json;\nconst body = $('Webhook prompt').first().json.body || {};\nconst aplicar = body.aplicar === true;\nconst cambios = body.cambios || [];\nconst nodo = wf.nodes.find(n => n.name === body.nodo);\nif (!nodo) return [{ json: { aplicar: false, error: 'nodo no encontrado', nodos: wf.nodes.map(n => n.name) } }];\nconst campo = body.campo || ['parameters', 'jsCode'];\nlet obj = nodo; for (const k of campo.slice(0, -1)) obj = obj[k];\nconst last = campo[campo.length - 1];\nlet p = obj[last];\nif (body.leer) return [{ json: { aplicar: false, texto: p } }];\nconst antes = p.length;\nconst conteos = cambios.map(([a]) => p.split(a).length - 1);\nif (!cambios.length || conteos.some(c => c !== 1)) return [{ json: { aplicar: false, error: 'algun texto no aparece exactamente 1 vez', conteos } }];\nfor (const [a, b] of cambios) p = p.replace(a, () => b);\nobj[last] = p;\nconst OK = ['saveExecutionProgress','saveManualExecutions','saveDataErrorExecution','saveDataSuccessExecution','executionTimeout','errorWorkflow','timezone','executionOrder','callerPolicy','callerIds','timeSavedPerExecution'];\nconst settings = Object.fromEntries(Object.entries(wf.settings || {}).filter(([k]) => OK.includes(k)));\nreturn [{ json: { aplicar, resumen: { workflow: wf.name, conteos, antes, despues: p.length, active: wf.active }, workflowObject: { name: wf.name, nodes: wf.nodes, connections: wf.connections, settings } } }];"
      }
    },
