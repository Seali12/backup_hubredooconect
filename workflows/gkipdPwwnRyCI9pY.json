      "parameters": {
        "jsCode": "// ======================================================\n// Webhook → teléfono AR + template por Tipo de negocio\n// Combos: CITROEN / FIAT / PEUGEOT\n// ======================================================\nconst root = $input.first()?.json || {};\nconst body = root.body || root;\n\nconst negocio = String(\n  body['Tipo de negocio'] ||\n  body.tipo_negocio ||\n  body.negocio ||\n  ''\n).trim();\n\nconst marca = String(\n  body.Marca ||\n  ''\n).trim();\n\nconst firstname =\n  String(body.Nombre_Cliente || '').trim() ||\n  'Cliente';\n\n// ======================================================\n// Teléfono: Celular / Telefono\n// ======================================================\nlet telefono =\n  body.Celular ||\n  body.Telefono ||\n  null;\n\nfunction normalizarTelefonoArgentina(numero) {\n  if (!numero) return null;\n\n  let limpio = String(numero).replace(/\\D/g, '');\n\n  if (limpio.startsWith('549') && limpio.length === 13) {\n    return limpio;\n  }\n\n  if (limpio.startsWith('54') && limpio.length === 12) {\n    return '549' + limpio.slice(2);\n  }\n\n  if (limpio.startsWith('0')) {\n    limpio = limpio.slice(1);\n  }\n\n  if (limpio.length === 10) {\n    return '549' + limpio;\n  }\n\n  return null;\n}\n\nconst whatsapp = normalizarTelefonoArgentina(telefono);\n\n// ======================================================\n// Normalizar negocio / marca\n// ======================================================\nconst negocioNorm = negocio\n  .normalize('NFD')\n  .replace(/[\\u0300-\\u036f]/g, '')\n  .toUpperCase()\n  .replace(/\\s+/g, ' ')\n  .trim();\n\nconst marcaNorm = marca\n  .normalize('NFD')\n  .replace(/[\\u0300-\\u036f]/g, '')\n  .toUpperCase()\n  .replace(/\\s+/g, ' ')\n  .trim();\n\n// ======================================================\n// Detectar marca\n// ======================================================\nconst hasCitroen =\n  marcaNorm.includes('CITROEN') ||\n  negocioNorm.includes('CITROEN');\n\nconst hasFiat =\n  marcaNorm.includes('FIAT') ||\n  negocioNorm.includes('FIAT');\n\nconst hasPeugeot =\n  marcaNorm.includes('PEUGEOT') ||\n  negocioNorm.includes('PEUGEOT');\n\n// ======================================================\n// Constantes Twilio Autofrance\n// ======================================================\nconst ACCOUNT_SID = 'TWILIO_SID_OCULTO';\nconst MESSAGING_SERVICE_SID = 'MG2f017dd3c25d710216538e8064169bb7';\nconst FROM_PHONE = 'whatsapp:+5491125599175';\nconst TWILIO_CREDENTIAL_REF = 'Twillio Autofrance';\n\n// ======================================================\n// Templates\n// ======================================================\nconst templates = [\n  {\n    ok: () => hasCitroen,\n    contentSid: 'HX9937c302816f7065b3edfb46f55297f5',\n    label: 'CITROEN',\n    tipo: 'CITROEN',\n  },\n  {\n    ok: () => hasFiat,\n    contentSid: 'HX816ceebf30ac4c5c4e28b623db4eb89e',\n    label: 'FIAT',\n    tipo: 'FIAT',\n  },\n  {\n    ok: () => hasPeugeot,\n    contentSid: 'HX20eee68bce321f7e45b2ad9af3bf053f',\n    label: 'PEUGEOT',\n    tipo: 'PEUGEOT',\n  },\n];\n\nconst tpl = templates.find((t) => t.ok()) || null;\n\n// ======================================================\n// ContentVariables\n// ======================================================\nconst contentVariablesObj = tpl\n  ? {\n      '1': firstname,\n      '2': '1231312312312',\n    }\n  : null;\n\nconst contentVariables = contentVariablesObj\n  ? JSON.stringify(contentVariablesObj)\n  : null;\n\n// ======================================================\n// Validaciones\n// ======================================================\nconst telefonoValido = whatsapp !== null;\nconst negocioValido = tpl !== null;\n\nconst valido =\n  telefonoValido &&\n  negocioValido;\n\n// ======================================================\n// Salida\n// ======================================================\nreturn [\n  {\n    json: {\n      valido,\n\n      telefonoValido,\n      negocioValido,\n\n      whatsapp,\n      to_phone: whatsapp,\n\n      negocio,\n      negocioNorm,\n\n      marca,\n      marcaNorm,\n\n      tipo: tpl?.tipo || null,\n      templateLabel: tpl?.label || null,\n\n      firstname,\n\n      account_sid: ACCOUNT_SID,\n      messaging_service_sid: MESSAGING_SERVICE_SID,\n      from_phone: FROM_PHONE,\n\n      content_sid: tpl?.contentSid || null,\n      content_variables: contentVariables,\n\n      original: telefono,\n\n      twilio_credential_ref: TWILIO_CREDENTIAL_REF,\n\n      source: 'n8n:autofrance-resenas-restricciones',\n\n      payload_json: {\n        negocio,\n        marca,\n        firstname,\n        whatsapp,\n        tipo: tpl?.tipo || null,\n        contentVariables,\n      },\n    },\n  },\n];"
      },
