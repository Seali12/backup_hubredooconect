      "parameters": {
        "jsCode": "// ======================================================\n// OBTENER TELÉFONO DESDE EL WEBHOOK\n// ======================================================\nconst telefono =\n  $input.first().json.body.Celular ||\n  $input.first().json.body.Telefono ||\n  null;\n\n// ======================================================\n// NORMALIZADOR ARGENTINA\n// ======================================================\nfunction normalizarTelefonoArgentina(numero) {\n  if (!numero) return null;\n\n  let limpio = String(numero).replace(/\\D/g, '');\n\n  // Ya viene como 549...\n  if (limpio.startsWith('549') && limpio.length === 13) {\n    return limpio;\n  }\n\n  // Viene como 54...\n  if (limpio.startsWith('54') && limpio.length === 12) {\n    return '549' + limpio.slice(2);\n  }\n\n  // Viene con 0 adelante\n  if (limpio.startsWith('0')) {\n    limpio = limpio.slice(1);\n  }\n\n  // Número nacional de 10 dígitos\n  if (limpio.length === 10) {\n    return '549' + limpio;\n  }\n\n  return null;\n}\n\n// ======================================================\n// NORMALIZAR\n// ======================================================\nconst whatsapp = normalizarTelefonoArgentina(telefono);\n\n// ======================================================\n// SALIDA\n// ======================================================\nreturn [\n  {\n    json: {\n      whatsapp: whatsapp,\n      valido: whatsapp !== null,\n      original: telefono\n    }\n  }\n];"
      },
