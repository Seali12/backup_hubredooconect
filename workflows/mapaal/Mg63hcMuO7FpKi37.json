    {
      "parameters": {
        "jsCode": "// Devuelve las marcas únicas disponibles en el dataset,\n// normalizadas (trim) y ordenadas alfabéticamente.\n\nconst input = $input.all();\n\nconst data = input[0].json;\nconst autos = Array.isArray(data) ? data[0].autos : data.autos;\n\nif (!autos || !Array.isArray(autos)) {\n  throw new Error(\"No se encontró el array 'autos' en el input.\");\n}\n\nconst marcasUnicas = [\n  ...new Set(autos.map(auto => auto.marca.trim()))\n].sort();\n\n// Opción A — un único ítem con array de marcas (útil para mostrar/loguear)\nreturn [\n  {\n    json: {\n      marcas: marcasUnicas,\n      total: marcasUnicas.length\n    }\n  }\n];\n\n// Opción B — un ítem por marca (útil para iterar en nodos siguientes)\n// Descomenta esto y comentá la opción A si la necesitás:\n// return marcasUnicas.map(marca => ({ json: { marca } }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
