      "name": "Get Cars1"
    },
    {
      "parameters": {
        "jsCode": "// Marcas posibles en el dataset:\n//   - FIAT / Fiat\n//   - RENAULT / Renault\n//   - Toyota\n//   - VOLKSWAGEN / Volkswagen\n//   - Mercedes benz\n//   - HONDA\n//   - Chevrolet\n//   - FORD\n//   - Nissan\n\n// Marca a filtrar (insensible a mayúsculas)\nconst MARCA_FILTRO = $('When Executed by Another Workflow').first().json.marca;\n\nconst input = $input.all();\n\n// El payload viene como array con un objeto que tiene la clave \"autos\"\nconst data = input[0].json;\nconst autos = Array.isArray(data) ? data[0].autos : data.autos;\n\nif (!autos || !Array.isArray(autos)) {\n  throw new Error(\"No se encontró el array 'autos' en el input.\");\n}\n\nconst filtrados = autos.filter(auto =>\n  auto.marca.trim().toLowerCase() === MARCA_FILTRO.trim().toLowerCase()\n);\n\nreturn filtrados.map(auto => ({ json: auto }));"
      },
