      },
      {
        "parameters": {
          "jsCode": "// Oculta datos sensibles solo en la copia que se sube a GitHub\nconst ocultar = (valor) => {\n  if (typeof valor === 'string') {\n    return valor\n      .replace(/AC[0-9a-fA-F]{32}/g, 'TWILIO_SID_OCULTO')\n      .replace(/((?:appkey|apikey|api_key|access_token|token)=)[A-Za-z0-9._-]{16,}/gi, '$1VALOR_OCULTO');\n  }\n  if (Array.isArray(valor)) return valor.map(ocultar);\n  if (valor && typeof valor === 'object') {\n    const copia = {};\n    for (const [k, v] of Object.entries(valor)) copia[k] = ocultar(v);\n    const sensible = typeof copia.name === 'string' && /key|token|secret|authorization|password/i.test(copia.name);\n    if (sensible && typeof copia.value === 'string' && copia.value.length >= 16 && !copia.value.includes('{{')) {\n      copia.value = 'VALOR_OCULTO';\n    }\n    return copia;\n  }\n  return valor;\n};\n\nconst orderJsonKeys = (jsonObj) => {\n  const ordered = {};\n  Object.keys(jsonObj).sort().forEach(key => {\n    ordered[key] = jsonObj[key];\n  });\n  return ordered;\n}\n\n// Check if file returned with content\nif (Object.keys($input.all()[0].json).includes(\"content\")) {\n  // Decode base64 content and parse JSON\n  const origWorkflow = JSON.parse(Buffer.from($input.all()[0].json.content, 'base64').toString());\n  const n8nWorkflow = ocultar($input.all()[1].json);\n  \n  // Order JSON objects\n  const orderedOriginal = orderJsonKeys(origWorkflow);\n  const orderedActual = orderJsonKeys(n8nWorkflow);\n\n  // Determine difference\n  if (JSON.stringify(orderedOriginal) === JSON.stringify(orderedActual)) {\n    $input.all()[0].json.github_status = \"same\";\n  } else {\n    $input.all()[0].json.github_status = \"different\";\n    $input.all()[0].json.n8n_data_stringy = JSON.stringify(orderedActual, null, 2);\n  }\n  $input.all()[0].json.content_decoded = orderedOriginal;\n// No file returned / new workflow\n} else if (Object.keys($input.all()[0].json).includes(\"data\")) {\n  const origWorkflow = JSON.parse($input.all()[0].json.data);\n  const n8nWorkflow = ocultar($input.all()[1].json);\n  \n  // Order JSON objects\n  const orderedOriginal = orderJsonKeys(origWorkflow);\n  const orderedActual = orderJsonKeys(n8nWorkflow);\n\n  // Determine difference\n  if (JSON.stringify(orderedOriginal) === JSON.stringify(orderedActual)) {\n    $input.all()[0].json.github_status = \"same\";\n  } else {\n    $input.all()[0].json.github_status = \"different\";\n    $input.all()[0].json.n8n_data_stringy = JSON.stringify(orderedActual, null, 2);\n  }\n  $input.all()[0].json.content_decoded = orderedOriginal;\n\n} else {\n  // Order JSON object\n  const n8nWorkflow = ocultar($input.all()[1].json);\n  const orderedActual = orderJsonKeys(n8nWorkflow);\n  \n  // Proper formatting\n  $input.all()[0].json.github_status = \"new\";\n  $input.all()[0].json.n8n_data_stringy = JSON.stringify(orderedActual, null, 2);\n}\n\n// Return items\nreturn $input.all();"
        },
