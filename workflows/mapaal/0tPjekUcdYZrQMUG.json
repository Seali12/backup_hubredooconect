    {
      "parameters": {
        "jsCode": "// ===============================\n// 1️⃣ DATOS DE ENTRADA\n// ===============================\nconst GROUP_ID = 335; // mismo grupo que se usa al crear el lead\n\nconst leadResp = $('HTTP Request').first().json;          // respuesta de Redoo Leads\nconst trigger = $('When Executed by Another Workflow').first().json;\nconst asesoresData = $('obtenerAsesores').first().json || {};\nconst reglasData = $('obtenerReglas').first().json || {};\n\nconst lead = leadResp.data || {};\n\n// Asesores del grupo: soporta varios formatos de respuesta\nconst advisors =\n  (Array.isArray(asesoresData.data) && asesoresData.data) ||\n  asesoresData.data?.users ||\n  asesoresData.data?.members ||\n  asesoresData.users ||\n  asesoresData.members ||\n  [];\n\n// Regla round robin activa del grupo 335\nconst reglas = (Array.isArray(reglasData.data) ? reglasData.data : [])\n  .filter(r => r.is_active && r.rule_type === 'round_robin');\n\nconst regla =\n  reglas.find(r => Number(r.group_id) === GROUP_ID) ||\n  reglas[0] ||\n  null;\n\n// ===============================\n// 2️⃣ RESOLVER EL ASESOR\n// ===============================\nlet advisor = null;\nlet origenAsesor = null;\n\n// a) El lead ya viene asignado en la respuesta → es el dato real\nif (lead.assigned_to_user?.id) {\n  advisor =\n    advisors.find(u => Number(u.id) === Number(lead.assigned_to_user.id)) ||\n    lead.assigned_to_user;\n  origenAsesor = 'assigned_to_user';\n}\n\n// b) Respaldo: calcularlo con el round robin\nif (!advisor && regla) {\n  const userIds = regla.configuration?.user_ids || [];\n  if (userIds.length) {\n    const idx = regla.current_index ?? 0;\n    // current_index ya avanzó al asignar → el asignado es el anterior\n    const pos = (idx - 1 + userIds.length) % userIds.length;\n    advisor = advisors.find(u => Number(u.id) === Number(userIds[pos])) || null;\n    origenAsesor = `round_robin (pos ${pos})`;\n  }\n}\n\n// ===============================\n// 3️⃣ NORMALIZAR TELÉFONO → 549XXXXXXXXXX\n// ===============================\nfunction normalizarTelefono(tel) {\n  if (!tel) return null;\n  let num = String(tel).replace(/\\D/g, '');\n  if (num.startsWith('54')) num = num.slice(2);\n  if (num.startsWith('9')) num = num.slice(1);\n  if (num.startsWith('0')) num = num.slice(1);\n  return num ? `549${num}` : null;\n}\n\n// ===============================\n// 4️⃣ SALIDA\n// ===============================\nconst out = {\n  ...trigger,\n  lead_id: lead.id || null,\n  lead_uuid: lead.uuid || null,\n  numero_vendedor: normalizarTelefono(advisor?.phone),\n  asesor_nombre: advisor\n    ? `${advisor.first_name || ''} ${advisor.last_name || ''}`.trim()\n    : null,\n  asesor_email: advisor?.email || null,\n  asesor_id: advisor?.id || null,\n  grupo_asignado: regla?.group?.name || null\n};\n\nconsole.log('Asignación de vendedor:', {\n  origenAsesor,\n  asesor: out.asesor_nombre,\n  telefonoOriginal: advisor?.phone || null,\n  telefonoNormalizado: out.numero_vendedor,\n  leadId: out.lead_id\n});\n\nreturn [{ json: out }];"
      },
