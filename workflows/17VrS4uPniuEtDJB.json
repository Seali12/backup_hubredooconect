    {
      "id": "96fa4b60-b395-410c-81fe-85c507e42604",
      "name": "Normalizar teléfono",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Normaliza telefonos argentinos a 549 + area + numero (10 digitos nacionales)\nconst norm = (raw) => {\n  const orig = String(raw ?? '').replace(/\\D/g, '');\n  let d = orig;\n  if (!d) return '';\n  d = d.replace(/^00/, '');\n  if (d.startsWith('54')) d = d.slice(2);\n  if (d.startsWith('9')) d = d.slice(1);\n  if (d.startsWith('0')) d = d.slice(1);\n  // quitar el 15 de celular despues del codigo de area\n  if (d.length === 12) {\n    const pos = d.startsWith('11') ? [2] : [3, 4, 2];\n    for (const p of pos) {\n      if (d.substr(p, 2) === '15') { d = d.slice(0, p) + d.slice(p + 2); break; }\n    }\n  }\n  return d.length === 10 ? '549' + d : orig;\n};\n\nconst body = { ...($json.body || {}) };\nbody.cliente_cel = norm(body.cliente_cel);\nbody.cliente_tel = norm(body.cliente_tel);\nreturn { json: { ...$json, body } };"
      }
    }
  ],
