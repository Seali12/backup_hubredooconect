        "body": "={\n  \"prospect\": {\n    \"requestdate\": \"{{ $now.toISO() }}\",\n    \"customer\": {\n      \"comments\": \"Operacion: {{ $json.FormaPago }} | Modelo: {{ $json.modelo || ''}} {{ $json.resumen || '-' }}\",\n      \"contacts\": [\n        {\n          \"emails\": [\n            {\n              \"value\": \"{{  $json.email || 'Sin mail' }}\"\n            }\n          ],\n          \"names\": [\n            {\n              \"part\": \"first\",\n              \"value\": \"{{ $json.name || $json.query.apellido}}\"\n            }\n          ],\n          \"phones\": [\n            {\n              \"type\": \"cellphone\",\n              \"value\": \"{{ $json.number || '546111111111'}}\"\n            }\n          ],\n          \"addresses\": []\n        }\n      ]\n    },\n    \"vehicles\": [\n      {\n        \"make\": \"Renault\",\n        \"model\": \"{{ $json.modelo || 'Desconocido' }}\",\n        \"trim\": \"{{ $json.vehicleTrim || '' }}\",\n        \"year\": \"{{ $json.vehicleYear || '2025' }}\"\n\n      }\n    ],\n    \"provider\": {\n      \"name\": {\n        \"value\": \"WHATSAPP WEB\"\n      },\n      \"service\": \"{{ $json.sub_origen }}\"\n    },\n    \"vendor\": {\n      \"contacts\": [],\n      \"vendorname\": {\n        \"value\": \"info@redoo.com.ar\"\n      }\n    }\n  }\n}",
