      {
        "parameters": {
          "jsCode": "return $input.all().map(item => {\n  const data = item.json;\n\n  const linea = data.linea;\n  const consulta = (data.consulta || '').toLowerCase().trim();\n  const formaPago = (data.FormaPago || '').toLowerCase().trim();\n\n  let prefijo = '';\n  let tipo = '';\n\n  // 1. Prefijo por línea\n  if (linea === '+5492615652023') {\n    prefijo = 'REDOO_MZA';\n  } else if (linea === '+5493513074750') {\n    prefijo = 'REDOO_CBA';\n  } else if (linea === '+5492604266488') {\n    prefijo = 'REDOO_SRA';\n  }\n\n  // 2. Tipo según consulta o FormaPago\n  if (formaPago.includes('contado')) {\n    tipo = 'CONV';\n  } else if (formaPago.includes('financiado')) {\n    tipo = 'PDA';\n  } else {\n    if (consulta.includes('usado')) {\n      tipo = 'USADO';\n    } else if (consulta.includes('plan')) {\n      tipo = 'PDA';\n    } else if (consulta.includes('contado')) {\n      tipo = 'CONV';\n    }\n  }\n\n  // 3. Resultado final\n  if (prefijo && tipo) {\n    data.sub_origen = `${prefijo}_${tipo}`;\n  } else if (prefijo) {\n    // 🔥 fallback por línea → siempre CONV\n    data.sub_origen = `${prefijo}_CONV`;\n  } else {\n    data.sub_origen = `${prefijo}_CONV`;\n  }\n\n  return item;\n});"
        },
