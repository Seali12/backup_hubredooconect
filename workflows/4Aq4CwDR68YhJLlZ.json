    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst vehicleText = (item.customer.vehicle?.vehicle_version_text || '').trim();\n\nif (!vehicleText) {\n  return [{ json: { ...item, resolved_version_id: null, needs_ai: false } }];\n}\n\nfunction normalize(str) {\n  return String(str || '')\n    .toLowerCase()\n    .normalize('NFD')\n    .replace(/[\\u0300-\\u036f]/g, '')\n    .replace(/[^a-z0-9]/g, ' ')\n    .replace(/\\s+/g, ' ')\n    .trim();\n}\n\nfunction tokenize(str) {\n  const stopwords = new Set(['de', 'la', 'el', 'en', 'con', 'del', 'los', 'las', 'por', 'se', 'un', 'una']);\n  return normalize(str).split(' ').filter(t => t.length >= 2 && !stopwords.has(t));\n}\n\nfunction matchScore(model, vNorm) {\n  const nameNorm = normalize(model.name);\n  const fullNorm = normalize(model.brand + ' ' + model.name);\n  const nameTokens = tokenize(model.name);\n\n  // Score 3: coincidencia exacta (nombre solo o marca+modelo)\n  if (vNorm === nameNorm || vNorm === fullNorm) return 3;\n\n  // Score 2: el texto contiene el nombre del modelo (no al revés)\n  if (vNorm.includes(nameNorm) || vNorm.includes(fullNorm)) return 2;\n\n  // Score 1: el nombre del modelo contiene el texto (ej: \"Yaris GR\" contiene \"Yaris\")\n  // Solo aplica si el texto ocupa al menos el 80% del nombre → evita matches muy genéricos\n  if (nameNorm.includes(vNorm) && vNorm.length >= nameNorm.length * 0.8) return 1;\n\n  // Score 1: todos los tokens del modelo aparecen en el texto\n  if (nameTokens.length > 0 && nameTokens.every(t => vNorm.includes(t))) return 1;\n\n  return 0;\n}\n\nconst vNorm = normalize(vehicleText);\nconst catalog = item.catalog || [];\n\n// Calcular score por modelo activo\nconst scored = catalog\n  .filter(m => m.is_active !== false)\n  .map(m => ({ model: m, score: matchScore(m, vNorm) }))\n  .filter(x => x.score > 0);\n\nif (scored.length === 0) {\n  return [{ json: { ...item, resolved_version_id: null, needs_ai: true } }];\n}\n\n// Quedarse solo con los del score más alto\nconst maxScore = Math.max(...scored.map(x => x.score));\nconst best = scored.filter(x => x.score === maxScore);\n\nif (best.length === 1) {\n  const activeVersions = best[0].model.versions.filter(v => v.is_active !== false);\n  if (activeVersions.length === 1) {\n    return [{ json: { ...item, resolved_version_id: activeVersions[0].id, needs_ai: false } }];\n  }\n  // Único modelo pero múltiples versiones → OpenAI\n  return [{ json: { ...item, resolved_version_id: null, needs_ai: true } }];\n}\n\n// Empate entre varios modelos al mismo score → OpenAI\nreturn [{ json: { ...item, resolved_version_id: null, needs_ai: true } }];"
      },
