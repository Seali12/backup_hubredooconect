      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst c = item.customer;\n\nconst customerPayload = {};\n\n// Campos de texto libre — pueden venir como string\nconst textFields = ['first_name', 'last_name', 'email', 'address', 'city', 'province', 'notes', 'document_type'];\ntextFields.forEach(f => {\n  if (c[f] !== undefined && c[f] !== null && c[f] !== '') {\n    customerPayload[f] = String(c[f]).trim();\n  }\n});\n\n// Campos que Excel convierte a número — forzar string siempre\nconst numericLikeFields = ['phone', 'mobile', 'postal_code', 'document_number'];\nnumericLikeFields.forEach(f => {\n  if (c[f] !== undefined && c[f] !== null && c[f] !== '') {\n    // Quitar decimales espurios (.0) que agrega Excel\n    customerPayload[f] = String(c[f]).replace(/\\.0$/, '').trim();\n  }\n});\n\ncustomerPayload.is_active = true;\n\nreturn [{\n  json: {\n    _api_key: item.api_key,\n    _vehicle: c.vehicle || null,\n    _resolved_version_id: item.resolved_version_id,\n    customer_payload: customerPayload\n  }\n}];"
