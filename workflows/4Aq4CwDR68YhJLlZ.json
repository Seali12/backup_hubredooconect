    {
      "parameters": {
        "jsCode": "const httpResponse = $input.first().json;\nconst prevData = $('Preparar payload OpenAI').first().json;\n\nlet resolvedVersionId = null;\ntry {\n  const content = httpResponse.choices[0].message.content;\n  const parsed = JSON.parse(content);\n  resolvedVersionId = typeof parsed.brand_vehicle_version_id === 'number' ? parsed.brand_vehicle_version_id : null;\n} catch(e) {\n  // Si falla el parseo, usamos null\n}\n\nreturn [{\n  json: {\n    api_key: prevData.api_key,\n    customer: prevData.customer,\n    resolved_version_id: resolvedVersionId\n  }\n}];"
