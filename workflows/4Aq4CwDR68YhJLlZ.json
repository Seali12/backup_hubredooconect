    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst v = item.vehicle;\n\nconst vehiclePayload = {};\n\n// Versión resuelta por IA (tiene prioridad)\nconst versionId = item.resolved_version_id || null;\nif (versionId) vehiclePayload.brand_vehicle_version_id = versionId;\n\nif (v.license_plate) vehiclePayload.license_plate = String(v.license_plate).trim();\nif (v.vin) vehiclePayload.vin = String(v.vin).trim();\nif (v.current_km !== undefined && v.current_km !== '') vehiclePayload.current_km = Number(v.current_km);\nif (v.year) vehiclePayload.year = Number(v.year);\nif (v.color) vehiclePayload.color = String(v.color);\nif (v.notes) vehiclePayload.notes = String(v.notes);\nvehiclePayload.is_active = true;\n\nreturn [{\n  json: {\n    api_key: item.api_key,\n    customer_id: item.customer_id,\n    vehicle_payload: vehiclePayload\n  }\n}];"
