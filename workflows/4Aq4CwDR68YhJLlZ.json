        "jsCode": "const httpResponse = $input.first().json;\nconst prevData = $('Preparar payload cliente').first().json;\n\nconst customerId = httpResponse.data && httpResponse.data.id;\nif (!customerId) {\n  // Si falla la creación, logueamos y saltamos el vehículo\n  console.error('Error creando cliente:', JSON.stringify(httpResponse));\n  return [{ json: { api_key: prevData._api_key, customer_id: null, vehicle: null, resolved_version_id: null, error: httpResponse } }];\n}\n\nreturn [{\n  json: {\n    api_key: prevData._api_key,\n    customer_id: customerId,\n    vehicle: prevData._vehicle,\n    resolved_version_id: prevData._resolved_version_id\n  }\n}];"
