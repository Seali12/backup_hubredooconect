      {
        "parameters": {
          "operation": "executeQuery",
          "query": "UPDATE ford_colombia SET reenvio_3 = IF(reenvio_1 = 1 AND reenvio_2 = 1, 1, reenvio_3), reenvio_2 = IF(reenvio_1 = 1 AND reenvio_2 = 0, 1, reenvio_2), reenvio_1 = IF(reenvio_1 = 0, 1, reenvio_1), status = IF(contesto = 1, status, 'recontacted'), status_changed_at = IF(contesto = 1, status_changed_at, UTC_TIMESTAMP()), envio_reason = 'recordatorio_enviado_desde_cola' WHERE envio_reason = 'recordatorio_encolado' AND ((id = $1 AND $1 > 0) OR ($1 = 0 AND $2 <> '' AND pilot_cellphone IN ($2, $3)))",
          "options": {
            "queryReplacement": "={{ $json.lead_id || 0 }},{{ String($json.to_phone).replace(/\\D/g, '').slice(-10) }},{{ '57' + String($json.to_phone).replace(/\\D/g, '').slice(-10) }}"
          }
        },
