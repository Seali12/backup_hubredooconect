          "query": "UPDATE ford_colombia SET envio = 1, envio_reason = 'enviado_desde_cola', status = IF(contesto = 1, 'answered', IF(`lead` IN ('good_lead', 'bad_lead'), status, 'sent')), status_changed_at = IF(contesto = 1, status_changed_at, UTC_TIMESTAMP()) WHERE envio = 0 AND envio_reason = 'encolado' AND ((id = $1 AND $1 > 0) OR ($1 = 0 AND $2 <> '' AND pilot_cellphone IN ($2, $3)))",
          "options": {
