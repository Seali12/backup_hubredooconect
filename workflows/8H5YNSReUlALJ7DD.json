          "jsCode": "const item = $input.first().json;\nconst status = Number(item.statusCode || 0);\nconst raw = item.body;\nconst body = raw && typeof raw === 'object' ? raw : {};\nconst matches = Array.isArray(body.matches) ? body.matches : [];\nconst technical = status === 0 || status === 401 || status === 403 || status >= 500;\nif (technical) {\n  return [{\n    json: {\n      exists: null,\n      error: true,\n      status,\n      message: 'No se pudo consultar el SGA. No asumir que el cliente no existe. No derivar.'\n    }\n  }];\n}\nconst found = body.exists === true || (body.exists !== false && status === 200 && matches.length > 0);\nreturn [{\n  json: {\n    exists: found,\n    error: false,\n    grupo: found ? 666 : 663,\n    grupoNombre: found ? 'Licitacion' : 'Atencion al Cliente',\n    matchesCount: matches.length\n  }\n}];"
