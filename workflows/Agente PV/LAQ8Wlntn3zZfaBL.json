          "url": "https://api.pilotsolution.net/v1/welcomes/events/create.php",
          "sendBody": true,
          "specifyBody": "json",
          "jsonBody": "={\n  \"data\": {\n    \"id\": \"{{ $('HTTP Request1').item.json.data.welcome_guid }}\",\n    \"event_type_code\": \"47\",\n    \"comment\": \"{{$('When Executed by Another Workflow').item.json.resumen }}\"\n  },\n  \"header\": {\n    \"FlowName\": \"event_create\",\n    \"SequenceId\": 1,\n    \"TimeStamp\": 1706880000,\n    \"TrackingId\": \"2B50DDB4-14C5-4249-82AB-049E6E735AA1\",\n    \"access_token\": \"{{ $json.result.entitydata.session.identityToken }}\"\n  }\n}\n",
          "options": {}
        },
        "id": "6bb53109-76d2-42a6-8c90-65a017dec191",
        "name": "Asesor",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [
          -80,
          464
        ],
        "executeOnce": true
      },
      {
        "parameters": {
          "operation": "executeQuery",
          "query": "SELECT\n  scc.settings ->> '$.username' AS pilot_username,\n  scc.settings ->> '$.password' AS pilot_password,\n  CAST(COALESCE(scc.settings ->> '$.account_index', '0') AS UNSIGNED) AS pilot_account_index\nFROM client_api_credentials cac\nJOIN sa_crm_configs scc\n  ON scc.client_id = cac.client_id\n AND scc.crm_type  = 'pilot'\n AND scc.is_active = 1\nWHERE cac.api_key  = '{{ $json.body.api_key }}'\n  AND cac.is_active = 1\nLIMIT 1;",
          "options": {}
        },
        "type": "n8n-nodes-base.mySql",
        "typeVersion": 2.5,
        "position": [
          -1728,
          -272
        ],
        "id": "b5e110da-19ab-4605-af78-0740b5310983",
        "name": "Execute a SQL query",
        "credentials": {
          "mySql": {
            "id": "7Z96txw3GwxFmnIg",
            "name": "MySQL account"
          }
        }
      },
      {
        "parameters": {
          "operation": "executeQuery",
          "query": "SELECT COALESCE(\n  (SELECT sil.code\n   FROM sa_interest_levels sil\n   JOIN sa_agent_configs sac ON sac.id = sil.agent_config_id\n   JOIN client_api_credentials cac ON cac.client_id = sac.client_id\n   WHERE cac.api_key = '{{ $json.body.api_key }}'\n     AND cac.is_active = 1\n     AND sil.is_active = 1\n     AND LOWER(sil.label) = LOWER('{{ $json.body.interest_level }}')\n   LIMIT 1),\n  (SELECT\n    CASE LOWER('{{ $json.body.interest_level }}')\n      WHEN 'hot'  THEN interest_code_high\n      WHEN 'warm' THEN interest_code_medium\n      WHEN 'cold' THEN interest_code_low\n    END\n   FROM sa_agent_configs sac\n   JOIN client_api_credentials cac ON cac.client_id = sac.client_id\n   WHERE cac.api_key = '{{ $json.body.api_key }}'\n     AND cac.is_active = 1\n   LIMIT 1)\n) AS custom_code;",
          "options": {}
        },
        "type": "n8n-nodes-base.mySql",
        "typeVersion": 2.5,
        "position": [
          -1728,
          -96
        ],
        "id": "89304aec-9ee9-4590-8b67-b82c882b16b3",
        "name": "Execute a SQL query1",
        "credentials": {
          "mySql": {
            "id": "7Z96txw3GwxFmnIg",
            "name": "MySQL account"
          }
        }
