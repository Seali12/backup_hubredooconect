      "id": "5b78be82-f57f-49fe-861e-f7ce33e207ad",
      "name": "getPrecios1",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -1120,
        288
      ]
    },
    {
      "parameters": {
        "jsCode": "// 🔹 Obtener todas las entradas (una por cada imagen)\nconst items = $input.all();\n\n// 🔹 Extraer solo los full_path de cada item\nconst urls = items.map(item => item.json.full_path).filter(Boolean);\n\n// 🔹 Unir todas las URLs en un solo string con \" | \"\nconst urlsConcatenadas = urls.join(' | ');\n\n// 🔹 Retornar un solo item con todas las URLs juntas\nreturn [\n  {\n    json: {\n      imagenes: urlsConcatenadas\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        384
      ],
      "id": "6d99748f-0039-461e-9ceb-8b0e4520a1d2",
      "name": "Code2"
    },
    {
      "parameters": {
        "jsCode": "// 🔹 Obtener el modelo enviado por otro workflow\nconst input = $('When Executed by Another Workflow').first().json;\nconst modeloBuscado = (input.modelo || \"\").toLowerCase().trim();\n\n// 🔹 Dividir en palabras\nconst tokens = modeloBuscado.split(/\\s+/).filter(Boolean);\n\n// 🔹 Obtener el JSON principal de vehículos\nconst data = $input.first().json;\nconst vehiculos = data?.entitydata || [];\n\n// 🔹 Función de coincidencia flexible\nfunction coincideFlexible(v, tokens) {\n\n  // 🔸 Omitir vehículos vendidos\n  if (v.availability_status?.code === \"3\") return false;\n\n  const brand = (v.brand || \"\").toLowerCase().trim();\n  const model = (v.model || \"\").toLowerCase().trim();\n  const version = (v.version || \"\").toLowerCase().trim();\n\n  // 🔸 Texto combinado (marca + modelo + versión)\n  const textoCompleto = `${brand} ${model} ${version}`;\n\n  // 🔸 Si no hay tokens no buscar nada\n  if (!tokens.length) return false;\n\n  // 🔸 Todos los tokens deben aparecer en model o version\n  return tokens.every(token =>\n    textoCompleto.includes(token)\n  );\n}\n\n// 🔹 Filtrar coincidencias\nconst encontrados = vehiculos.filter(v =>\n  coincideFlexible(v, tokens)\n);\n\n// 🔹 Devolver resultados completos\nreturn encontrados.map(v => ({\n  json: v\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "id": "1cfc7d66-d879-4998-93c8-4d42a2dda29b",
      "name": "marchear_modelo"
    },
    {
      "parameters": {
        "jsCode": "// 🔹 Obtener todos los items de entrada\nconst allItems = $input.all();\n\n// 🔹 Array para guardar todas las imágenes encontradas\nlet todasLasImagenes = [];\n\n// 🔹 Recorrer cada item y extraer las imágenes con size \"phone\"\nfor (const item of allItems) {\n  const data = item.json;\n  const imagenes = data?.result?.entitydata || [];\n\n  const filtradas = imagenes.filter(img => img.size?.toLowerCase() === 'phone');\n  todasLasImagenes.push(...filtradas);\n}\n\n// 🔹 Retornar cada imagen como item independiente\nreturn todasLasImagenes.map(img => ({ json: img }));\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
