        "parameters": {
          "jsCode": "// Obtener todas las filas del input\nconst filas = $input.all();\n\n// Verificar que hay datos\nif (!filas || filas.length === 0) {\n  return [{ nextId: 1 }];\n}\n\n// Extraer todos los IDs de la columna 'ID' (primera columna)\nconst ids = filas.map(fila => {\n  // Obtener el primer valor del objeto (primera columna)\n  const primerValor = Object.values(fila.json)[1];\n  return parseInt(primerValor) || 0;\n});\n\n// Obtener el ID máximo\nconst maxId = Math.max(...ids);\n\n// Calcular el siguiente ID\nconst nextId = maxId + 1;\n\n// Retornar el resultado\nreturn [{ nextId: nextId }];"
