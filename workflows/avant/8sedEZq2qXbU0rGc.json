      {
        "parameters": {
          "jsCode": "// ===============================\n// 1️⃣ OBTENER DATOS DE ENTRADA\n// ===============================\nconst lead = $(\"When Executed by Another Workflow\").item.json;\nconst sheetRows = $input.all(1).map(i => i.json);\n\n// ===============================\n// 2️⃣ FUNCIONES AUXILIARES\n// ===============================\nfunction normalize(text) {\n  return (text || '')\n    .toString()\n    .trim()\n    .toUpperCase();\n}\n\nfunction getRandomItem(arr) {\n  return arr[Math.floor(Math.random() * arr.length)];\n}\n\n// ===============================\n// 3️⃣ MAPEO SUCURSAL + MARCA → ORIGEN\n// ===============================\nconst ORIGEN_MAP = {\n  \"SANTIAGO\": {\n    \"CITROEN\":  \"G1TUESDO25KA27MF5\",\n    \"EICHER\":   \"G1TUICMEG5J8H4PC1\",\n    \"FORTHING\": \"G1TUH3CB7L39B8U0S\",\n    \"ZX AUTO\":  \"G1TUHS9S0GQN1VSW1\",\n    \"BESTUNE\":  \"G1TUGCUMTB0NZ2BLS\",\n    \"212\":      \"G1TUIVLHXDUXPJOJK\"\n  },\n  \"CHARLES SUMNER\": {\n    \"ZX AUTO\":  \"G1TUHDKT4THBBHVCW\",\n    \"FORTHING\": \"G1TUGS3IESWSBX9G\",\n    \"EICHER\":   \"G1TUI5BAGI5ZAVNR5\",\n    \"CITROEN\":  \"G1TUD4SFEUDXL70S\",\n    \"BESTUNE\":  \"G1TUG1QDITY8VX8NK\",\n    \"212\":      \"G1TUIM12AXX8D5045\"\n  }\n};\n\n// Origen por defecto — solo se usa cuando FueraHorario === true\nconst ORIGEN_DEFAULT = {\n  \"CHARLES SUMNER\": \"G1TUESDO25KA27MF5\",\n  \"SANTIAGO\":       \"G1TUD4SFEUDVXL70S\"\n};\n\n// ===============================\n// 4️⃣ DETECTAR SUCURSAL, MARCA Y FUERA DE HORARIO\n// ===============================\nconst sucursal     = normalize(lead.sucursal);\nconst modelo       = normalize(lead.modelo);\nconst resumen      = normalize(lead.resumen);\nconst fueraHorario = lead.FueraHorario === true;\n\nconst sucursalMap = ORIGEN_MAP[sucursal] || {};\n\nlet marcaDetectada = null;\nfor (const marca of Object.keys(sucursalMap)) {\n  if (modelo.includes(marca) || resumen.includes(marca)) {\n    marcaDetectada = marca;\n    break;\n  }\n}\n\n// ===============================\n// 5️⃣ RESOLVER ORIGEN\n// ===============================\nlet origen = null;\n\nif (fueraHorario) {\n  // Fuera de horario → siempre usar el default por sucursal\n  origen = ORIGEN_DEFAULT[sucursal] || null;\n} else if (marcaDetectada && sucursalMap[marcaDetectada]) {\n  // Dentro de horario con match → usar el código específico\n  origen = sucursalMap[marcaDetectada];\n}\n\n// ===============================\n// 6️⃣ DETECTAR MARCA PARA ASIGNAR CONCESIONARIO (lógica original)\n// ===============================\nlet marcaParaConcesionario = marcaDetectada;\n\nif (!marcaParaConcesionario) {\n  for (const row of sheetRows) {\n    const concesionario = normalize(row.Concesionario);\n    if (modelo.includes(concesionario) || resumen.includes(concesionario)) {\n      marcaParaConcesionario = concesionario;\n      break;\n    }\n  }\n}\n\n// ===============================\n// 7️⃣ FILTRAR FILAS QUE MATCHEAN\n// ===============================\nlet filasMatch = [];\nif (marcaParaConcesionario) {\n  filasMatch = sheetRows.filter(row =>\n    normalize(row.Concesionario) === marcaParaConcesionario\n  );\n}\n\n// ===============================\n// 8️⃣ SI NO HAY MATCH → USAR DEFAULT\n// ===============================\nif (filasMatch.length === 0) {\n  const DEFAULT_CONCESIONARIO = \"CITROEN\";\n  filasMatch = sheetRows.filter(row =>\n    normalize(row.Concesionario) === DEFAULT_CONCESIONARIO\n  );\n  marcaParaConcesionario = DEFAULT_CONCESIONARIO;\n}\n\n// ===============================\n// 9️⃣ ELEGIR UNO ALEATORIO\n// ===============================\nconst filaSeleccionada = filasMatch[Math.floor(Math.random() * filasMatch.length)];\n\n// ===============================\n// 🔟 RESPUESTA FINAL\n// ===============================\nreturn [{\n  json: {\n    ...lead,\n    origen,\n    marca_detectada:    marcaParaConcesionario,\n    concesionario_data: filaSeleccionada,\n    interes: $('When Executed by Another Workflow').first().json.Interes\n  }\n}];"
        },
