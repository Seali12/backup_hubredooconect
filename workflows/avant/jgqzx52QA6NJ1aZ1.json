      {
        "parameters": {
          "jsCode": "return (() => {\n  const p1=$('GIAMA_1').first().json.turnosDisponibles\n  // const p2=$('GIAMA_2').first().json.turnosDisponibles\n  // const allTurnos = [...p1, ...p2] si son dos calendarios se descomenta este\n  const allTurnos = [...p1]\n  \n  \n  function pick(arr){\n    const res=[]\n    const days=[...new Set(arr.map(t=>t.dia))]\n    \n    // Primero intenta tomar uno por día\n    while(res.length<4 && days.length){\n      const d=days.splice(Math.floor(Math.random()*days.length),1)[0]\n      const opts=arr.filter(t=>t.dia===d)\n      if(opts.length)res.push(opts[Math.floor(Math.random()*opts.length)])\n    }\n    \n    // Si no llegó a 4, completa con turnos de días ya usados\n    while(res.length<4){\n      const remaining = arr.filter(t => !res.some(r => r.dia === t.dia && r.inicio === t.inicio))\n      if(remaining.length === 0) break\n      res.push(remaining[Math.floor(Math.random()*remaining.length)])\n    }\n    \n    return res.map(t=>({dia:t.dia,inicio:t.inicio,final:t.final,Id_Calendario:t.Id_Calendario}))\n  }\n  \n  return [{json: {turnos: pick(allTurnos)}}]\n})()"
        },
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          592,
          16
        ],
        "id": "950ced31-8667-41db-9078-47674b757bbe",
        "name": "Code"
      },
      {
        "parameters": {
          "jsCode": "const data = $input.first().json;\nconst queryData = data.query;\n\nlet km, modelo;\n\n// Verificar si es un string con coma\nif (typeof queryData === 'string' && queryData.includes(',')) {\n    const parts = queryData.split(',');\n    km = parts[0];\n    modelo = parts[1];\n} else {\n    // Si viene en otro formato\n    km = queryData;\n    modelo = data.modelo || '';\n}\n\nreturn [{json:{query: data, km: km, modelo: modelo}}];"
        },
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          48,
          16
        ],
        "id": "33456da4-c3d9-4efd-9612-a049dae25c66",
        "name": "Code3"
      },
      {
        "parameters": {
          "jsCode": "return (() => {\n    const data = $('Get row(s) in sheet1').first().json;\n    const queryData = $('When Executed by Another Workflow').first().json.query;\n    \n    // Si queryData es un string como \"60000,Etios\"\n    let modelo;\n    \n    if (typeof queryData === 'string' && queryData.includes(',')) {\n        const parts = queryData.split(',');\n        modelo = parts[1].trim();  // Extraer \"Etios\"\n    } else {\n        // Si viene en otro formato\n        modelo = queryData.modelo || queryData.Modelo || queryData.MODELO;\n    }\n    \n    // Retornar el tiempo del modelo desde el sheet\n    return [{json:{query: data[modelo] || \"00:30:00\"}}];\n})()"
        },
