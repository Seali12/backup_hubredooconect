    {
      "parameters": {
        "jsCode": "// ======================================================\n// OBTENER TELÉFONO DESDE EL WEBHOOK\n// ======================================================\nconst body = $input.first()?.json?.body || {};\n\nlet telefono =\n  body.pilot_cellphone ||\n  body.pilot_phone ||\n  null;\n\n// ======================================================\n// SI NO VIENE EN LOS CAMPOS DE TELÉFONO,\n// BUSCAR número_de_whatsapp DENTRO DE pilot_notes\n// ======================================================\nif (!telefono && body.pilot_notes) {\n  const matchWhatsapp = body.pilot_notes.match(\n    /n[uú]mero_de_whatsapp:\\s*([+\\d\\s()-]+)/i\n  );\n\n  if (matchWhatsapp) {\n    telefono = matchWhatsapp[1].trim();\n  }\n}\n\n// ======================================================\n// NORMALIZADOR ARGENTINA (WHATSAPP / TWILIO SAFE)\n// ======================================================\nfunction normalizarTelefonoArgentina(numero) {\n  if (!numero || typeof numero !== 'string') return null;\n\n  // Eliminar todo lo que no sea número\n  let limpio = numero.replace(/\\D/g, '');\n\n  // ==================================================\n  // CASO 1: Ya viene con 549\n  // Ej: 5491124090483\n  // ==================================================\n  if (limpio.startsWith('549') && limpio.length === 13) {\n    return limpio;\n  }\n\n  // ==================================================\n  // CASO 2: Viene con 54 pero sin 9\n  // Ej: 541124090483\n  // ==================================================\n  if (limpio.startsWith('54') && limpio.length === 12) {\n    return '549' + limpio.slice(2);\n  }\n\n  // ==================================================\n  // CASO 3: Empieza con 0 (formato nacional)\n  // Ej: 01124090483\n  // ==================================================\n  if (limpio.startsWith('0')) {\n    limpio = limpio.slice(1);\n  }\n\n  // ==================================================\n  // CASO 4: Área + número\n  // Ej: 1124090483\n  // ==================================================\n  if (limpio.length === 10) {\n    return '549' + limpio;\n  }\n\n  // ==================================================\n  // No válido\n  // ==================================================\n  return null;\n}\n\n// ======================================================\n// NORMALIZAR\n// ======================================================\nconst whatsapp = normalizarTelefonoArgentina(telefono);\n\n// ======================================================\n// SALIDA\n// ======================================================\nreturn [\n  {\n    json: {\n      whatsapp: whatsapp,\n      valido: whatsapp !== null,\n      original: telefono\n    }\n  }\n];"
      },
