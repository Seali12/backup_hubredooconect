      "parameters": {
        "jsCode": "// ======================================================\n// Webhook → teléfono AR + template por pilot_negocio\n// Combos: FIAT/PEUGEOT × (0km | plan ahorro)\n// ======================================================\nconst root = $input.first()?.json || {};\nconst body = root.body || root;\n\nconst negocio = String(\n  body.pilot_negocio ||\n  body.pilot_negocio ||\n  body.negocio ||\n  ''\n).trim();\n\nconst firstname =\n  String(body.pilot_firstname || '').trim() ||\n  [body.pilot_firstname, body.pilot_lastname]\n    .filter((v) => v != null && String(v).trim() !== '')\n    .map((v) => String(v).trim())\n    .join(' ') ||\n  'Cliente';\n\n// ======================================================\n// Teléfono: cellphone / phone / notes\n// ======================================================\nlet telefono =\n  body.pilot_cellphone ||\n  body.pilot_phone ||\n  null;\n\nif (!telefono && body.pilot_notes) {\n  const matchWhatsapp = String(body.pilot_notes).match(\n    /n[uú]mero_de_whatsapp:\\s*([+\\d\\s()-]+)/i\n  );\n  if (matchWhatsapp) {\n    telefono = matchWhatsapp[1].trim();\n  }\n}\n\nfunction normalizarTelefonoArgentina(numero) {\n  if (!numero || typeof numero !== 'string') return null;\n\n  let limpio = numero.replace(/\\D/g, '');\n\n  if (limpio.startsWith('549') && limpio.length === 13) {\n    return limpio;\n  }\n\n  if (limpio.startsWith('54') && limpio.length === 12) {\n    return '549' + limpio.slice(2);\n  }\n\n  if (limpio.startsWith('0')) {\n    limpio = limpio.slice(1);\n  }\n\n  if (limpio.length === 10) {\n    return '549' + limpio;\n  }\n\n  return null;\n}\n\nconst whatsapp = normalizarTelefonoArgentina(\n  telefono == null ? null : String(telefono)\n);\n\n// ======================================================\n// Normalizar negocio (case, acentos, espacios)\n// ======================================================\nconst negocioNorm = negocio\n  .normalize('NFD')\n  .replace(/[\\u0300-\\u036f]/g, '')\n  .toUpperCase()\n  .replace(/\\s+/g, ' ')\n  .trim();\n\nconst hasFiat = negocioNorm.includes('FIAT');\nconst hasPeugeot = negocioNorm.includes('PEUGEOT');\nconst has0km =\n  negocioNorm.includes('0KM') ||\n  negocioNorm.includes('0 KM') ||\n  /(?:^|\\s)0\\s*KM(?:\\s|$)/.test(negocioNorm);\nconst hasPlan =\n  negocioNorm.includes('AHORRO') ||\n  negocioNorm.includes('PLAN');\n\n// ======================================================\n// Constantes Twilio Autofrance (igual que tu workflow)\n// ======================================================\nconst ACCOUNT_SID = 'TWILIO_SID_OCULTO';\nconst MESSAGING_SERVICE_SID = 'MG2f017dd3c25d710216538e8064169bb7';\nconst FROM_PHONE = 'whatsapp:+5491125599175';\nconst TWILIO_CREDENTIAL_REF = 'Twillio Autofrance';\n\nconst MEDIA_CONV = 'Fiat-1878_20251028_100924.jpg';\nconst MEDIA_PLAN =\n  'WhatsApp-Image-2025-07-14-at-12.32.12-PM_20251110_100927.jpeg';\n\n// Orden: plan antes que 0km\nconst templates = [\n  {\n    // FIAT PLAN DE AHORRO / FIAT Plan Ahorro / etc.\n    ok: () => hasFiat && hasPlan,\n    contentSid: 'HX20ff62cb687d69dc515856e8e889e033',\n    media: MEDIA_PLAN,\n    label: 'FIAT plan',\n  },\n  {\n    // PEUGEOT Plan Ahorro / PEUGEOT PLAN DE AHORRO / etc.\n    ok: () => hasPeugeot && hasPlan,\n    contentSid: 'HX630f9fb753919980dbddb629c09d1358',\n    media: MEDIA_PLAN,\n    label: 'PEUGEOT plan',\n  },\n  {\n    // FIAT 0KM / FIAT 0 Km / FIAT 0 KM\n    ok: () => hasFiat && has0km,\n    contentSid: 'HX005819dec3335166af7be59489c2acec',\n    media: MEDIA_CONV,\n    label: 'FIAT convencional',\n  },\n  {\n    // PEUGEOT 0KM / PEUGEOT 0 Km / PEUGEOT 0 KM\n    ok: () => hasPeugeot && has0km,\n    contentSid: 'HX756b2f71087df0e30a1e4e612e7c08d5',\n    media: MEDIA_CONV,\n    label: 'PEUGEOT convencional',\n  },\n];\n\nconst tpl = templates.find((t) => t.ok()) || null;\n\nconst contentVariablesObj = tpl\n  ? {\n      '1': firstname,\n      '2': tpl.media,\n      '3': '1231312312312',\n    }\n  : null;\n\nconst contentVariables = contentVariablesObj\n  ? JSON.stringify(contentVariablesObj)\n  : null;\n\nreturn [\n  {\n    json: {\n      negocio,\n      negocioNorm,\n      templateLabel: tpl?.label || null,\n      whatsapp,\n      to_phone: whatsapp,\n      valido: Boolean(whatsapp && tpl),\n      original: telefono,\n      account_sid: ACCOUNT_SID,\n      messaging_service_sid: MESSAGING_SERVICE_SID,\n      from_phone: FROM_PHONE,\n      content_sid: tpl?.contentSid || null,\n      content_variables: contentVariables,\n      twilio_credential_ref: TWILIO_CREDENTIAL_REF,\n      source: 'n8n:autofrance-piloto',\n      payload_json: {\n        negocio,\n        firstname,\n        whatsapp,\n        contentVariables,\n      },\n    },\n  },\n];"
      },
