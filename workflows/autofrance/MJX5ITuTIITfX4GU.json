    {
      "parameters": {
        "jsCode": "// ======================================================\n// Webhook → preparar disparo restringido FIAT PDA\n// ======================================================\nconst root = $input.first()?.json || {};\nconst body = root.body || root;\n\n// ======================================================\n// DATOS DEL CLIENTE\n// ======================================================\nconst firstname =\n  String(body.Nombre_Cliente || '').trim() ||\n  'Cliente';\n\nconst marca =\n  String(body.Marca || '').trim();\n\nconst sucursal =\n  String(body.Sucursal || '').trim();\n\nconst fechaHora =\n  String(\n    body['Fecha y Hora Aproximada '] ||\n    body['Fecha y Hora Aproximada'] ||\n    ''\n  ).trim();\n\n// ======================================================\n// TELÉFONO\n// ======================================================\nlet telefono =\n  body.Celular ||\n  body.Telefono ||\n  null;\n\n// ======================================================\n// NORMALIZADOR ARGENTINA\n// ======================================================\nfunction normalizarTelefonoArgentina(numero) {\n  if (!numero) return null;\n\n  let limpio = String(numero).replace(/\\D/g, '');\n\n  if (limpio.startsWith('549') && limpio.length === 13) {\n    return limpio;\n  }\n\n  if (limpio.startsWith('54') && limpio.length === 12) {\n    return '549' + limpio.slice(2);\n  }\n\n  if (limpio.startsWith('0')) {\n    limpio = limpio.slice(1);\n  }\n\n  if (limpio.length === 10) {\n    return '549' + limpio;\n  }\n\n  return null;\n}\n\nconst whatsapp = normalizarTelefonoArgentina(telefono);\n\n// ======================================================\n// NORMALIZAR MARCA\n// ======================================================\nconst marcaNorm = marca\n  .normalize('NFD')\n  .replace(/[\\u0300-\\u036f]/g, '')\n  .toUpperCase()\n  .replace(/\\s+/g, ' ')\n  .trim();\n\n// ======================================================\n// VALIDAR MARCA\n// ======================================================\nconst marcaValida =\n  ['FIAT', 'PEUGEOT'].includes(marcaNorm);\n\n// ======================================================\n// CONSTANTES TWILIO AUTOFANCE\n// ======================================================\nconst ACCOUNT_SID =\n  'TWILIO_SID_OCULTO';\n\nconst MESSAGING_SERVICE_SID =\n  'MG2f017dd3c25d710216538e8064169bb7';\n\nconst FROM_PHONE =\n  'whatsapp:+5491125599175';\n\nconst CONTENT_SID =\n  'HXd598d02218559e7cd2e1153000c60e94';\n\nconst TWILIO_CREDENTIAL_REF =\n  'Twillio Autofrance';\n\n// ======================================================\n// CONTENT VARIABLES\n// ======================================================\nconst contentVariablesObj = {\n  '1': firstname,\n  '2': marca,\n  '3': sucursal,\n  '4': fechaHora\n};\n\nconst contentVariables =\n  JSON.stringify(contentVariablesObj);\n\n// ======================================================\n// VALIDACIONES\n// ======================================================\nconst telefonoValido =\n  whatsapp !== null;\n\nconst datosClienteValidos =\n  firstname !== '' &&\n  firstname !== 'Cliente';\n\nconst sucursalValida =\n  sucursal !== '';\n\nconst fechaHoraValida =\n  fechaHora !== '';\n\nconst templateValido =\n  CONTENT_SID !== '';\n\n// ======================================================\n// VALIDACIÓN GENERAL\n// ======================================================\nconst valido =\n  telefonoValido &&\n  datosClienteValidos &&\n  marcaValida &&\n  sucursalValida &&\n  fechaHoraValida &&\n  templateValido;\n\n// ======================================================\n// SALIDA\n// ======================================================\nreturn [\n  {\n    json: {\n      valido,\n\n      telefonoValido,\n      datosClienteValidos,\n      marcaValida,\n      sucursalValida,\n      fechaHoraValida,\n      templateValido,\n\n      whatsapp,\n      to_phone: whatsapp,\n\n      firstname,\n\n      marca,\n      marcaNorm,\n\n      sucursal,\n      fechaHora,\n\n      account_sid: ACCOUNT_SID,\n      messaging_service_sid: MESSAGING_SERVICE_SID,\n      from_phone: FROM_PHONE,\n\n      content_sid: CONTENT_SID,\n      content_variables: contentVariables,\n\n      original: telefono,\n\n      twilio_credential_ref: TWILIO_CREDENTIAL_REF,\n\n      source: 'n8n:autofrance-fiat-pda-restricciones',\n\n      payload_json: {\n        firstname,\n        marca,\n        sucursal,\n        fechaHora,\n        whatsapp,\n        contentVariables\n      }\n    }\n  }\n];"
      },
