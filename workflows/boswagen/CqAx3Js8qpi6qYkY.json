    {
      "parameters": {
        "jsCode": "const items = $input.all();\nfor (let i = 0; i < items.length; i++) {\n  const item = items[i].json;\n  const resumenRaiz = item.resumen ? item.resumen.toLowerCase() : '';\n  const resumenQuery = (item.query && item.query.resumen) ? item.query.resumen.toLowerCase() : '';\n  const origenRaiz = item.origen ? item.origen.toLowerCase() : '';\n  const origenQuery = (item.query && item.query.origen) ? item.query.origen.toLowerCase() : '';\n\n  let esMascarello = false;\n  let esPostventa = false;\n\n  // Detectar Mascarello primero (prioridad sobre postventa)\n  // Se chequea origen Y resumen como fallback (por si el agente no envió origen correctamente)\n  if (\n    origenRaiz === 'mascarello' ||\n    origenQuery === 'mascarello' ||\n    resumenRaiz.includes('mascarello') ||\n    resumenQuery.includes('mascarello')\n  ) {\n    esMascarello = true;\n  }\n\n  // Detectar Postventa (solo si no es Mascarello)\n  if (!esMascarello) {\n    // Chequear campo Postventa (mayúscula y minúscula) y postventa en query\n    if (\n      item.Postventa === 'si' ||\n      item.postventa === 'si' ||\n      (item.query && item.query.postventa === 'si')\n    ) {\n      esPostventa = true;\n    } else if (resumenRaiz.includes('postventa') || resumenQuery.includes('postventa')) {\n      esPostventa = true;\n    } else if (origenRaiz === 'postventa' || origenQuery === 'postventa') {\n      esPostventa = true;\n    }\n  }\n\n  // Asignar el ID de origen según el resultado\n  if (esMascarello) {\n    item.origen = \"G27YE7XZYGS9WL3IO\"; // Origen Mascarello (Cód. de negocio de Pilot)\n  } else if (esPostventa) {\n    item.origen = \"FWZVLN6ULW00YH0FK\"; // Origen Postventa\n  } else {\n    item.origen = \"ESDR4WJG78QXQ88K1\"; // Origen Ventas / Otros\n  }\n\n  if (item.query) {\n    item.query.origen = item.origen;\n    item.query.postventa = esPostventa ? \"si\" : \"no\";\n  }\n}\nreturn items;"
      },
