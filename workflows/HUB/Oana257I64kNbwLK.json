    {
      "parameters": {
        "jsCode": "const productos = $(\"getProductos\").all().map(i => i.json);\nconst cliente = $(\"Get row(s) in sheet\").first().json;\n\nconst clientesMap = {\n  USUARIOS: \"Usuario\",\n  COMERCIOSREVENDEDORES: \"Comercio\",\n  MAYORCONSUMIDOR: \"Sub\",\n  MUNICIPIOSYSERVICIOSPUBLICO: \"Sub\",\n  INDUSTRIAS: \"Sub\",\n  COMEDORES: \"Sub\"\n};\n\nconst tipoUsuario = clientesMap[cliente.Categoria] || \"\";\n\nconst productosFiltrados = productos.filter(\n  p => (p.TipoDeUsuario || \"\").trim().toUpperCase() === tipoUsuario.trim().toUpperCase()\n);\n\nreturn [\n  {\n    ...cliente,\n    lista: {\n      \"0\":{\n        articulos: {...productosFiltrados}\n      }\n    }\n  }\n];"
      },
