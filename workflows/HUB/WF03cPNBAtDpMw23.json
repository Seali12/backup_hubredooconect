      "name": "buscoForm"
    },
    {
      "parameters": {
        "jsCode": "// Obtener datos de los nodos anteriores\nconst formData = $input.first().json;\nconst surveyData = $('buscoSurveys').first().json;\n\n// Extraer la descripción de la primera pregunta\nlet description = formData.result[0].questions[0].description;\n\n// Extraer datos del cliente\nconst firstName = surveyData.result[0].customer_firstname;\nconst lastName = surveyData.result[0].customer_lastname;\nconst phone = surveyData.result[0].customer_phone;\nconst location = surveyData.result[0].location;\n\n// Reemplazar los placeholders\ndescription = description.replace('*|CLIENTE_NOMBRE|*', firstName);\ndescription = description.replace('*|CLIENTE_APELLIDO|*', lastName);\ndescription = description.replace('*|SUCURSAL|*', location);\n\n// Remover etiquetas HTML\ndescription = description.replace(/<[^>]*>/g, '');\n\n// Remover entidades HTML como &nbsp;\ndescription = description.replace(/&nbsp;/g, ' ');\n\n// Limpiar espacios múltiples y trim\ndescription = description.replace(/\\s+/g, ' ').trim();\n\n// Devolver el resultado\nreturn {\n  json: {\n    description: description,\n    customer_phone: phone,\n    customer_firstname: firstName,\n    customer_lastname: lastName,\n    id_encuesta: $input.first().json.result[0].id\n  }\n};"
      },
