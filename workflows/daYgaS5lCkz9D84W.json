    {
      "parameters": {
        "toolDescription": "=Ejecuta esta función para crear el prespuesto, previamente debes contar con los \"componentes\" del tipo de reparación y el \"access_token\" para autehnticarte. Si no tiene eso, vuelve al flujo generar para consultarlo. Haz la peticion y espera el id del presupuesto. Una vez que lo tengas, guardalo en memoria como \"prespuesto\" y dígale al cliente que le vas a estar enviando la propuesta dentro de unos minutos. Los componentes deben enviase de la siguiente manera de ejemplo: \n{\n  \"client\": \"Marcelo\",\n  \"parts\": [{\"CANTIDAD\": 1, \"NO_PARTE\": \"10R9069\", \"DESCRIPCION\": \"PUMP GP HYD\"}],\n  \"model\": \"320D FAL\",\n  \"repair_type\": \"BOMBA HIDRAULICA REMAN\",\n  \"series\": \"string\"\n}\n",
        "method": "POST",
        "url": "https://apiaitest.tracsa.com.mx/api/v1/partslist/",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $fromAI('access_token') }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"client\": \"{{ $fromAI('nombre') }}\",\n  \"parts\": {{ $fromAI('componentes') }},\n  \"model\": \"{{ $fromAI('modelo') }}\",\n  \"repair_type\": \"{{ $fromAI('reparacion') }}\",\n  \"series\": \"string\"\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequestTool",
      "typeVersion": 4.2,
      "position": [
        1072,
        720
      ],
      "id": "c42dc6ff-ae14-4921-a5da-43f379841b70",
      "name": "crear_presupuesto"
    }
