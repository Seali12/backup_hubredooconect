      "parameters": {
        "jsCode": "const out = []; const d0 = Date.parse('2026-11-01T05:00:00Z'); const fin = Date.now() + 3600e3;\nfor (let a = d0; a < fin; a += 3 * 86400e3) { const b = a + 3 * 86400e3; const f = x => new Date(x).toISOString().slice(0, 19) + '.000';\n  out.push({ json: { filters: [ { field: 'created', operation: '>=', value: f(a) }, { field: 'created', operation: '<', value: f(b) } ] } }); }\nreturn out;"
      }
    },
