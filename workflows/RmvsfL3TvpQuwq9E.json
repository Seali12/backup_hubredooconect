      ],
      "parameters": {
        "jsCode": "const m = {}; let total = 0, fallos = 0; const origenes = {};\nfor (const it of $input.all()) { const r = it.json.result || {}; if (r.status !== 'success') { fallos++; continue; }\n  for (const x of (r.entitydata || [])) { total++; const o = (x.origin || {}).code; origenes[o] = (origenes[o] || 0) + 1; if (o !== 'ford_digital_colombia') continue;\n    m[x.id] = [ (x.status || {}).code, (x.status || {}).name, (x.interest_level || {}).name || '', (x.created || {}).dt, (x.prospect || {}).cellphone || '', ((x.asigned || {}).user || {}).fullname || '', x.bad_flag, ((x.created || {}).user || {}).fullname || '' ]; } }\nreturn [{ json: { total, fallos, origenes, n: Object.keys(m).length, leads: m } }];"
      }
    }
