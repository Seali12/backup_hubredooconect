      ],
      "parameters": {
        "jsCode": "const v = $('Ventanas').all(); const out = [];\n$input.all().forEach((it, i) => { const r = it.json.result || {}; if (r.status !== 'success') throw new Error('contar fallo: ' + JSON.stringify(it.json).slice(0, 300));\n  const n = Math.ceil((Number((r.aditional_data || {}).rows_count) || 0) / 100); if (n > 50) throw new Error('ventana con mas de 5000');\n  for (let p = 1; p <= n; p++) out.push({ json: { filters: v[i].json.filters, page: p } }); });\nreturn out;"
      }
    },
