      {
        "parameters": {
          "jsCode": "const lead = $('Normalizar teléfonos').item.json;\n\nconst phone = (lead.buyer_phone || '').replace(/\\D/g, '').replace(/^54/, '').slice(-10);\nconst nombreParts = (lead.buyer_nombre || '').trim().split(' ');\nconst firstName = nombreParts.slice(0, -1).join(' ') || nombreParts[0] || '';\nconst lastName = nombreParts.slice(-1)[0] || '';\nconst today = new Date().toISOString().split('T')[0];\nconst description = `Publicación: ${lead.item_id} | Precio: ${lead.item_precio}| Asesor: ${$input.first().json.email} | Link: ${lead.item_permalink || ''}`.substring(0, 255);\n\nreturn {\n  json: {\n    FirstName: firstName,\n    LastName: lastName,\n    Origin: \"Mercado Libre\",\n    Phone: phone,\n    Email: lead.buyer_email || 'noproporciono@email.com',\n    ConcesionarioId: \"001f200001tAFcqAAG\",\n    Description: description,\n    Product: lead.item_titulo || '',\n    City: \"Buenos Aires\",\n    State: \"Buenos Aires\",\n    Country: \"Argentina\",\n    MarketingAllowance: \"true\",\n    DateOfConsent: today,\n    lead_id: lead.id\n  }\n};"
        },
        "id": "f55b91e8-1e94-433d-a608-81ccee179d1f",
        "name": "🧩 PayloadVW",
        "type": "n8n-nodes-base.code",
