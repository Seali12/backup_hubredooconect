      {
        "parameters": {
          "jsCode": "// Prioridad: lo que corrigió el cliente en el chat > lo que vino de Mercado Libre > lo que mandó el bot\nconst i = $input.first().json;\nconst vacio = v => v === undefined || v === null || ['', '-', 'no especificado', 'null', 'undefined'].includes(String(v).trim().toLowerCase());\nconst pick = (...vals) => { const v = vals.find(x => !vacio(x)); return v === undefined ? '-' : String(v).trim(); };\n\nconst ids = String(i.ml_lead_ids || '').split(',').map(s => s.trim()).filter(s => /^[0-9a-f-]{36}$/i.test(s));\nconst telefono = pick(i.number, i.ml_phone);\nconst sufijo = telefono.replace(/\\D/g, '').slice(-8);\n// Sin conversación (carga por falta de respuesta): id numérico propio derivado del id de meli_leads.\n// Sirve de clave para el control de duplicados y no coincide con ninguna fila de conversations (que espera un número).\nconst idSinConversacion = ids[0] ? String(900000000000000 + parseInt(ids[0].replace(/-/g, '').slice(0, 12), 16) % 1e14) : '';\n\nreturn [{\n  json: {\n    ...i,\n    idConversation: vacio(i.idConversation) ? idSinConversacion : i.idConversation,\n    number: telefono,\n    name: pick(i.nombre_corregido, i.ml_nombre, i.name),\n    productoInteres: pick(i.ml_modelo, i.productoInteres),\n    dni: pick(i.dni, i.ml_dni),\n    email: pick(i.email, i.ml_email),\n    goodLead: String(i.goodLead ?? 'false'),\n    interes: pick(i.interes, 'cold'),\n    no_derivar: String(i.no_derivar).trim().toLowerCase() === 'true',\n    ids_sql: ids.length ? ids.map(id => `'${id}'`).join(',') : \"''\",\n    sufijo: sufijo.length === 8 ? sufijo : ''\n  }\n}];"
        },
