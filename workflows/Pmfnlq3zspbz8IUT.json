        "parameters": {
          "jsCode": "const data = $input.item.json;\n\nconst pilotLeadId = data.pilot_lead_id ? `'${data.pilot_lead_id}'` : 'NULL';\nconst pilotResponse = (data.pilot_response || '').replace(/'/g, \"''\");\n\nreturn {\n  json: {\n    query: `UPDATE meli_leads SET status = '${data.new_status}', pilot_lead_id = ${pilotLeadId}, sf_response = '${pilotResponse}' WHERE id = '${data.lead_id}'`\n  }\n};"
