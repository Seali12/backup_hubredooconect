      "parameters": {
        "jsCode": "const lead = $('🔀 Resolver Asesor/Marca').item.json;\n\nconst CONTACT_TYPE_ID = 1;\nconst appkey = 'C13E65C9-12BE-4C82-BB10-C2D8B5A18483';\n\nconst name = (lead.buyer_nombre || '').trim();\nconst cellphone = lead.buyer_phone || '';\nconst notes = `Publicación: ${lead.item_id} | Precio: ${lead.item_precio} | Link: ${lead.item_permalink || ''} | Asesor: ${lead.asesor_nombre_match || ''} | Teléfono asesor: ${lead.asesor_phone || ''}`;\n\nconst url = `https://api.pilotsolution.net/webhooks/welcome.php?action=create&appkey=${appkey}&pilot_firstname=${encodeURIComponent(name)}&pilot_cellphone=${encodeURIComponent(cellphone)}&pilot_contact_type_id=${CONTACT_TYPE_ID}&pilot_business_type_id=${lead.pilot_business_type_id}&pilot_notes=${encodeURIComponent(notes)}&pilot_suborigin_id=${lead.pilot_origin}&pilot_product_of_interest=${encodeURIComponent(lead.item_titulo || '')}`;\n\nreturn {\n  json: {\n    lead_id: lead.id,\n    user_id: lead.user_id,\n    destino: lead.destino,\n    url,\n    pilot_origin: lead.pilot_origin,\n    pilot_business_type_id: lead.pilot_business_type_id\n  }\n};"
      },
