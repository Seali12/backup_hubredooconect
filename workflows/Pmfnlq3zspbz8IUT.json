        "id": "1772fad9-8c56-4baa-b275-1cb3cc418de6",
        "name": "🚀 POST Pilot",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [
          1824,
          224
        ],
        "alwaysOutputData": true,
        "onError": "continueRegularOutput"
      },
      {
        "parameters": {
          "jsCode": "const lead = $input.item.json;\nconst normalizarTel = (tel) => {\n  if (!tel) return null;\n  const digits = tel.toString().replace(/\\D/g, '');\n  return digits.slice(-8);\n};\nconst normalizarBuyerPhone = (tel) => {\n  if (!tel) return null;\n  let digits = tel.toString().replace(/\\D/g, '');\n  if (digits.startsWith('549')) return '+' + digits;\n  if (digits.startsWith('54')) return '+549' + digits.slice(2);\n  if (digits.startsWith('9') && digits.length >= 10) return '+54' + digits;\n  return '+549' + digits;\n};\nconst sufijo1 = normalizarTel(lead.asesor_phone);\nconst sufijo2 = normalizarTel(lead.asesor_phone2);\nreturn {\n  json: {\n    ...lead,\n    buyer_phone: normalizarBuyerPhone(lead.buyer_phone),\n    asesor_sufijo1: sufijo1 || '',\n    asesor_sufijo2: sufijo2 || ''\n  }\n};"
        },
        "id": "7d966edf-0209-428c-896b-abe26d4f01ef",
        "name": "Normalizar teléfonos",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          896,
          240
        ]
      },
      {
        "parameters": {
          "jsCode": "const lead = $('Normalizar teléfonos').item.json;\nconst asesor = $('🗄️ Buscar asesor').item.json;\n\nreturn {\n  json: {\n    ...lead,\n    pilot_assigned_user: asesor?.email || null,\n    asesor_nombre_match: asesor?.nombre || null,\n    marca_detectada: 'SANZARI',\n    pilot_origin: 'FTRCELHZXWQ30WWZK',\n    pilot_business_type_id: 1\n  }\n};"
        },
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          1216,
          240
        ],
        "id": "948924b2-8c5b-4a96-b9eb-eb2f5800c254",
        "name": "🔀 Resolver Asesor/Marca"
      },
      {
        "parameters": {
          "jsCode": "const pilotResponse = $input.item.json;\nconst prev = $('PayloadPilot').item.json;\n\nconst pilotLeadId = pilotResponse?.data?.welcome_id || null;\nconst success = pilotResponse.success && !pilotResponse.error && !pilotResponse.message?.toLowerCase().includes('error');\n\nreturn {\n  json: {\n    lead_id: prev.lead_id,\n    pilot_lead_id: pilotLeadId,\n    new_status: success ? 'sent' : 'error',\n    pilot_response: JSON.stringify(pilotResponse)\n  }\n};"
        },
        "id": "49f20483-2f7c-4f36-b5b5-692cb9b9ca23",
        "name": "Procesar respuesta Pilot",
        "type": "n8n-nodes-base.code",
